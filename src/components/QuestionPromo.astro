---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ArrowLink from './ArrowLink.astro';
import Button from './Button.astro';
import {
  episodeNumber,
  MAILING_LIST_URL,
  monthDay,
  PAST_EPISODES_URL,
  PREVIOUS_EPISODES_URL,
  questionSchedule,
  scheduleLines,
  type Episode,
  type QuestionState,
} from '../lib/the-question';

interface Props {
  episode: Episode;
  /* Pins a state instead of letting the browser choose, for the style guide.
     The real card ships every panel and lets the head script pick. */
  state?: QuestionState;
}

const { episode, state } = Astro.props;
const { title, cohosts, topic, answerBy, answerUrl, date } = episode.data;

const schedule = questionSchedule(episode);
const lines = scheduleLines(episode);
const thisEpisode = episodeNumber(episode);
/* The closed panel names the episode after this one, since it only ever
   appears once this question has gone. */
const nextEpisode = String(episode.data.number + 1).padStart(3, '0');

// Globbed rather than imported directly: a static import of a file that isn't
// there yet is a build error, and the artwork lands separately.
const artworkModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/_the-q-sidebar.{png,jpg,jpeg,webp,avif,svg}',
  { eager: true },
);
const artwork = Object.values(artworkModules)[0]?.default;
---

{/* data-state is the pinned state or nothing; the head script writes
     data-question-state on <html> and the CSS below reads whichever applies.
     With no script and no pin, the neutral panel is what shows — which is why
     every word of it has to be true before the survey opens, while it's open,
     and after it has closed. Nothing in it may say "open" or "closed". */}
<section class="question-promo" data-state={state} data-schedule={JSON.stringify(schedule)}>
  <h2 class="question-promo__title">
    The Question
    <span class="question-promo__status" hidden>
      {' '}
      is Open
    </span>
  </h2>
  {artwork && (
    // The image is the whole of this link, so its alt is the link's
    // accessible name — it has to say where the link goes rather than
    // describe the artwork.
    <a class="question-promo__art-link" href={PAST_EPISODES_URL}>
      <Image
        class="question-promo__art"
        src={artwork}
        alt="The Question, on bencallahan.com"
        width={Math.min(artwork.width, 832)}
        format={artwork.format === 'svg' ? undefined : 'webp'}
      />
    </a>
  )}

  <div class="question-promo__panel">
    <h3 class="question-promo__question">
      Episode {thisEpisode}: {title}
    </h3>
    <div class="question-promo__details">
      {cohosts.length > 0 && (
        <p class="question-promo__meta">
          <i>
            with{' '}
            {cohosts.map((cohost, i) => (
              <>
                {i > 0 && (i === cohosts.length - 1 ? ' and ' : ', ')}
                <a href={cohost.url}>{cohost.name}</a>
              </>
            ))}
          </i>
        </p>
      )}
      {topic && <p class="question-promo__meta">Exploring {topic}.</p>}

      {/* The schedule as plain fact — the only form that stays true at every
           moment, and so the only one the no-script card can carry. */}
      <ul class="question-promo__schedule">
        {lines.map((line) => (
          <li class="question-promo__meta">{line}</li>
        ))}
      </ul>
    </div>

    {answerUrl && answerBy && (
      <div class="question-promo__open-only" hidden>
        <Button class="question-promo__cta" href={answerUrl} size="md">
          Answer The Question
        </Button>
        <p class="question-promo__meta">
          Answer by {monthDay(answerBy)} to get your invite to the deep dive on {monthDay(date)}!
        </p>
      </div>
    )}

    <div class="question-promo__closed-only" hidden>
      <p class="question-promo__meta">
        Episode {nextEpisode} is right around the corner! Sign up so you don't miss out.
      </p>
      <Button class="question-promo__cta" href={MAILING_LIST_URL} size="md">
        Get The Question via Email
      </Button>
    </div>

    <ArrowLink href={PREVIOUS_EPISODES_URL} direction="right" size="smaller">
      See Previous Episodes
    </ArrowLink>
  </div>
</section>

<style>
  .question-promo {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  /* Block so the anchor wraps the image tightly, and a matching radius so the
     focus ring follows the artwork rather than the base layer's --radius-xs.

     The negative margin cancels the column gap so the panel below sits flush
     against the artwork and the two read as one card. It lives here rather
     than on the panel because the artwork is globbed: with no image to find,
     nothing renders and there is no gap to cancel. */
  .question-promo__art-link {
    display: block;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    margin-block-end: calc(-1 * var(--space-sm));
  }

  .question-promo__art {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  /* Matches the section headings in Sidebar.astro, not a page-level h2. */
  .question-promo__title {
    font-size: var(--font-size-lg);
    margin-block: var(--space-xs) 0;
  }

  /* base.css balances every heading, which splits a two-line question in a
     narrow column at an awkward point. */
  .question-promo__question {
    margin: 0;
    margin-block-end: calc(var(--space-2xs) - var(--space-sm));
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
    text-wrap: wrap;
  }

  .question-promo__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .question-promo__schedule {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Only lightly muted, and the panel's tint decides how far it can go: on the
     panel below, 20% transparent drops to 4.15:1 and misses AA, where 12%
     clears it at 4.94:1. Darkening the panel moves both numbers. */
  .question-promo__meta {
    margin: 0;
    color: color-mix(in srgb, var(--color-text), transparent 12%);
  }

  /* Square across the top because it butts up against the artwork — the
     rounding there belongs to the image.

     White, so the panel lifts off the cream sidebar card rather than sinking
     into it. The pairing is only 1.15:1, the same near-invisible step the
     Callout's white tone makes — it reads as a change of plane, not a border. */
  .question-promo__panel {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-gray-100);
  }

  /* No display here: `hidden` is what keeps these out until a state asks for
     them, and an author rule setting display would beat it. The rules at the
     bottom set it, once. */
  .question-promo__open-only,
  .question-promo__closed-only {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  .question-promo__cta {
    width: 100%;
  }

  /* The three parts that can only be true in one state ship `hidden`, so a
     card with no script running says nothing it might have to take back —
     and so does one whose stylesheet never arrived. The rules below are what
     bring a part back, which is why each sets display explicitly. */

  /* The state is settled in Layout.astro's head script, before this markup is
     parsed, so the swaps can never be seen happening. */
  :global(:root[data-question-state='open'])
    .question-promo:not([data-state])
    .question-promo__status,
  .question-promo[data-state='open'] .question-promo__status {
    display: inline;
  }

  :global(:root[data-question-state='open'])
    .question-promo:not([data-state])
    .question-promo__open-only,
  .question-promo[data-state='open'] .question-promo__open-only {
    display: flex;
  }

  :global(:root[data-question-state='closed'])
    .question-promo:not([data-state])
    .question-promo__closed-only,
  .question-promo[data-state='closed'] .question-promo__closed-only {
    display: flex;
  }
</style>
