---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ArrowLink from './ArrowLink.astro';
import Button from './Button.astro';
import { currentQuestion } from '../data/the-question';
import {
  isLive,
  MAILING_LIST_URL,
  PAST_EPISODES_URL,
  PREVIOUS_EPISODES_URL,
  type Question,
} from '../lib/the-question';

interface Props {
  question?: Question;
}

const { question = currentQuestion } = Astro.props;

// Only the real card expires in the browser. A caller that supplied its own
// question (the style guide) must keep rendering the state it asked for, no
// matter what the live question has since done.
const autoExpire = Astro.props.question === undefined;
const live = isLive(question);

// Globbed rather than imported directly: a static import of a file that isn't
// there yet is a build error, and the artwork lands separately.
const artworkModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/_the-q-sidebar.{png,jpg,jpeg,webp,avif,svg}',
  { eager: true },
);
const artwork = Object.values(artworkModules)[0]?.default;

// en-US for month-then-day ("August 29"), which is how the show's own dates
// read. UTC because the data is written in UTC — see src/data/the-question.ts.
const dateFmt = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
const cohosts = new Intl.ListFormat('en-US').format(question.cohosts);
// Formatted up here so the sentence below stays one expression per line. Left
// as bare text around the <time> tags, Prettier reflows it and pads every
// boundary with {' '} — and since Astro also emits a space for the line break
// itself, each gap comes out doubled. Hence the bare strings there, with no
// spaces of their own: the line breaks supply them, exactly one each.
const episodeOn = dateFmt.format(question.episodeDate);
const answerByOn = dateFmt.format(question.answerBy);

// Three digits, the way the show numbers itself — "Episode 081", not 81.
const episodeNo = (n: number) => String(n).padStart(3, '0');
const thisEpisode = episodeNo(question.number);
// The fallback names the episode after this one, since it only ever appears
// once this question has closed.
const nextEpisode = episodeNo(question.number + 1);
---

<section
  class="question-promo"
  data-state={live ? 'live' : 'closed'}
  data-auto-expire={autoExpire ? '' : undefined}
>
  {
    /* Closed is the bare title, so only the open state adds anything and the
      head script's one-way expiry can strip it back without a rebuild — same
      reason the two panels below are both in the markup. */
  }
  <h2 class="question-promo__title">
    The Question{
      live && <span class="question-promo__status question-promo__status--open"> is Open</span>
    }
  </h2>
  {
    artwork && (
      // The image is the whole of this link, so its alt is the link's
      // accessible name — it has to say where the link goes rather than
      // describe the artwork. That's why the strapline and the photo of Ben
      // don't appear in it.
      <a class="question-promo__art-link" href={PAST_EPISODES_URL}>
        <Image
          class="question-promo__art"
          src={artwork}
          alt="The Question, on bencallahan.com"
          width={Math.min(artwork.width, 832)}
          format={artwork.format === 'svg' ? undefined : 'webp'}
        />
      </a>
    )
  }

  {
    live && (
      <div class="question-promo__live">
        <h3 class="question-promo__question">
          Episode {thisEpisode}: {question.question}
        </h3>
        <div class="question-promo__details">
          <p class="question-promo__meta">
            <i>with {cohosts}</i>
          </p>
          <p class="question-promo__meta">
            {'Answer by'}
            <time datetime={question.answerBy.toISOString()}>{answerByOn}</time>
            {'to get your invite to the deep dive on'}
            <time datetime={question.episodeDate.toISOString()}>{episodeOn}</time>!
          </p>
        </div>
        <Button class="question-promo__cta" href={question.answerUrl} size="md">
          Answer The Question
        </Button>
        <ArrowLink href={PREVIOUS_EPISODES_URL} direction="right" size="smaller">
          See Previous Episodes
        </ArrowLink>
      </div>
    )
  }

  <div class="question-promo__fallback">
    <p class="question-promo__meta">
      Episode {nextEpisode} is right around the corner! Sign up so you don't miss out.
    </p>
    <Button class="question-promo__cta" href={MAILING_LIST_URL} size="md">
      Get The Question via Email
    </Button>
    <ArrowLink href={PREVIOUS_EPISODES_URL} direction="right" size="smaller"
      >See Previous Episodes</ArrowLink
    >
  </div>
</section>

<style>
  .question-promo {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  /* Block so the anchor wraps the image tightly, and a matching radius so the
     focus ring follows the artwork rather than the base layer's --radius-xs.

     The negative margin cancels the column gap so the panel below sits flush
     against the artwork and the two read as one card. It lives here rather
     than on the panels because the artwork is globbed: with no image to find,
     nothing renders and there is no gap to cancel. */
  .question-promo__art-link {
    display: block;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    margin-block-end: calc(-1 * var(--space-sm));
  }

  .question-promo__art {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  /* Matches the section headings in Sidebar.astro, not a page-level h2. */
  .question-promo__title {
    font-size: var(--font-size-lg);
    margin-block: var(--space-xs) 0;
  }

  /* base.css balances every heading, which splits a two-line question in a
     narrow column at an awkward point.

     The negative bottom margin trims the panel's gap down to the one the
     details block uses internally, so the heading and the lines under it read
     as one group while the CTA keeps the full gap. */
  .question-promo__question {
    margin: 0;
    margin-block-end: calc(var(--space-2xs) - var(--space-sm));
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
    text-wrap: wrap;
  }

  .question-promo__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* Only lightly muted, and the panel's tint decides how far it can go: on the
     panel below, 20% transparent drops to 4.15:1 and misses AA, where 12%
     clears it at 4.94:1. Darkening the panel moves both numbers. */
  .question-promo__meta {
    margin: 0;
    color: color-mix(in srgb, var(--color-text), transparent 12%);
  }

  /* One panel shared by both states, so the deadline passing swaps content
     without changing the card's shape. Square across the top because it butts
     up against the artwork — the rounding there belongs to the image.

     White, so the panel lifts off the cream sidebar card rather than sinking
     into it. The pairing is only 1.15:1, the same near-invisible step the
     Callout's white tone makes — it reads as a change of plane, not a border. */
  .question-promo__live,
  .question-promo__fallback {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-gray-100);
  }

  .question-promo__cta {
    width: 100%;
  }

  /* Expiry is one-way and decided in Layout.astro's head script, before this
     markup is parsed, so the swaps below can never be seen happening. */
  .question-promo[data-state='live'] .question-promo__fallback {
    display: none;
  }

  :global(:root[data-question-expired])
    .question-promo[data-state='live'][data-auto-expire]
    .question-promo__live,
  :global(:root[data-question-expired])
    .question-promo[data-state='live'][data-auto-expire]
    .question-promo__status--open {
    display: none;
  }

  :global(:root[data-question-expired])
    .question-promo[data-state='live'][data-auto-expire]
    .question-promo__fallback {
    display: flex;
  }
</style>
