---
import { inlineSlot } from '../lib/inline-slot';

interface Props {
  id?: string;
}

const { id } = Astro.props;

// An <h2> takes phrasing content only, so the slot can't carry the paragraph
// MDX wraps it in. See inlineSlot.
const content = await inlineSlot(Astro.slots);
---

<h2 class="hero" id={id} set:html={content} />

<style>
  /* One size at every width: main is not monotonic — it narrows when the rail
     appears at 850px and again when the aside splits at 1300px — so a container
     query on the column fires in both directions on the way out. */
  .hero {
    margin-block-start: 0;
    font-size: var(--font-size-hero);
  }

  .hero :global(.accent) {
    color: var(--color-green);
  }
</style>
