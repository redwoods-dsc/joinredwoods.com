---
import { inlineSlot } from '../lib/inline-slot';

interface Props {
  id?: string;
}

const { id } = Astro.props;

// An <h2> takes phrasing content only, so the slot can't carry the paragraph
// MDX wraps it in. See inlineSlot.
const content = await inlineSlot(Astro.slots);
---

<h2 class="hero" id={id} set:html={content} />

<style>
  /* One size at every width. This used to step up once the main column passed
     640px, but the column is not monotonic — it narrows when the rail appears
     at 850px and again when the aside splits off at 1300px — so the step fired
     three times on the way out, and the small end was --font-size-3xl, which is
     an h2. A single size a step above the heading scale holds either way. */
  .hero {
    margin-block-start: 0;
    font-size: var(--font-size-hero);
  }

  /* Slotted content is not scoped to this component, so the accent has to be
     addressed globally to reach a <span> written in the page's Markdown. */
  .hero :global(.accent) {
    color: var(--color-green);
  }
</style>
