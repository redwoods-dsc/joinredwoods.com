---
import { inlineSlot } from '../lib/inline-slot';

interface Props {
  id?: string;
}

const { id } = Astro.props;

// An <h2> takes phrasing content only, so the slot can't carry the paragraph
// MDX wraps it in. See inlineSlot.
const content = await inlineSlot(Astro.slots);
---

<h2 class="hero" id={id} set:html={content} />

<style>
  /* Not a container query: the main column isn't monotonic — it narrows when
     the rail appears at 850px and again when the aside splits off at 1300px —
     so sizing on the column steps the hero three times on the way out. 600px is
     where the column reaches ~480px, under which the hero sets as seven lines. */
  .hero {
    margin-block-start: 0;
    font-size: var(--font-size-2xl);
  }

  @media (min-width: 600px) {
    .hero {
      font-size: var(--font-size-hero);
    }
  }

  .hero :global(.accent) {
    color: var(--color-green);
  }
</style>
