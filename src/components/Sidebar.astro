---
import { getCollection } from 'astro:content';
import ArrowLink from './ArrowLink.astro';
import EntryCard from './EntryCard.astro';
import QuestionPromo from './QuestionPromo.astro';

// The sidebar is a taster, not an index — /field-notes carries the full list.
const MAX_ARTICLES = 6;

const articles = (await getCollection('articles', (entry) => !entry.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, MAX_ARTICLES);
---

<div class="sidebar">
  <section class="sidebar__card">
    <h2>From the Field Notes</h2>
    <div class="sidebar__list">
      {
        articles.map((article) => (
          <EntryCard
            href={`/field-notes/${article.id}/`}
            secondaryLabel={article.data.authors.join(', ')}
            primaryLabel={article.data.title}
            date={article.data.date}
            tone={article.data.tone}
          />
        ))
      }
    </div>
    <ArrowLink href="/field-notes/" direction="right" size="smaller" margin="md"
      >Read all Field Notes</ArrowLink
    >
  </section>
  <QuestionPromo />
</div>

<style>
  .sidebar {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Held in view beside a long article. Which edge it holds by depends on
     whether it fits: shorter than the window it pins near the top and never
     moves; taller, it scrolls until its bottom meets the foot of the viewport
     and locks there, so its own end is always reachable.

     min() picks between the two on its own. The second term is the lock line
     for the tall case and goes negative exactly as the sidebar outgrows the
     window, at which point it wins; while the sidebar fits, zero wins.

     Both edges lock flush, with no inset either way: the card's own --space-lg
     padding is the breathing room, and insetting on top of it would read as
     double. Flush at the top also means the sidebar always travels the 24px
     the page's padding puts above it before it takes hold, rather than
     appearing to catch before it has moved at all.

     It has to be `top` in both cases. A bottom inset only pulls a box up when
     it would fall below the line — it never pushes one down to hold it there,
     so `bottom` lets this scroll straight past. Offsetting the top by the
     element's own height puts the lock where its bottom meets the viewport
     floor, which is why the script publishes a measured height.

     Only from 1300px, where the aside becomes a column of its own; below that
     it sits under main with nothing to stay alongside. The aside stretches to
     the row's height, so this rides inside it and the cream card is unaffected.
     Without JS --sidebar-height is absent, `top` computes to auto and the
     sidebar simply scrolls. */
  @media (min-width: 1300px) {
    .sidebar {
      position: sticky;
      top: min(0px, calc(100dvh - var(--sidebar-height)));
    }
  }

  .sidebar__card h2 {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-lg);
  }

  .sidebar__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
</style>

<script>
  // Publishes the one number the stylesheet can't work out for itself: how tall
  // this is. The comparison against the window is CSS's job, via 100dvh — so
  // only the element's own height needs watching, not the viewport's.
  const sidebar = document.querySelector<HTMLElement>('.sidebar');

  if (sidebar) {
    const sync = () => {
      const height = sidebar.offsetHeight;
      // Guarded because this runs under a ResizeObserver watching the same
      // element: writing a property it already holds is a needless style pass.
      if (sidebar.style.getPropertyValue('--sidebar-height') !== `${height}px`) {
        sidebar.style.setProperty('--sidebar-height', `${height}px`);
      }
    };

    sync();
    new ResizeObserver(sync).observe(sidebar);
  }
</script>
