---
import { getCollection } from 'astro:content';
import EntryCard from './EntryCard.astro';
import QuestionPromo from './QuestionPromo.astro';

// The sidebar is a taster, not an index — /field-notes carries the full list.
const MAX_ARTICLES = 3;

const articles = (await getCollection('articles', (entry) => !entry.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, MAX_ARTICLES);
---

<div class="sidebar">
  <section class="sidebar__card">
    <h2>From the Fieldnotes</h2>
    <div class="sidebar__list">
      {
        articles.map((article) => (
          <EntryCard
            href={`/field-notes/${article.id}/`}
            secondaryLabel={article.data.authors.join(', ')}
            primaryLabel={article.data.title}
            date={article.data.date}
            tone={article.data.tone}
          />
        ))
      }
    </div>
  </section>
  <QuestionPromo />
</div>

<style>
  .sidebar {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .sidebar__card h2 {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-lg);
  }

  .sidebar__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
</style>
