---
interface Props {
  href: string;
  exact?: boolean;
  class?: string;
}

const { href, exact = false, class: className } = Astro.props;
const { pathname } = Astro.url;

const isCurrent = exact ? pathname === href : pathname.startsWith(href);
---

<a aria-current={isCurrent ? 'page' : undefined} class:list={[className]} href={href}>
  <slot />
</a>

<style>
  /* Use :global() to apply styles to the <a> element rendered by this component */
  :global(.nav) {
    a {
      border-radius: var(--radius-sm);
      color: var(--color-accent-contrast);
      font-family: var(--font-serif);
      font-weight: var(--font-weight-semibold);
      line-height: 1;
      padding: 0 var(--space-xs);
      text-decoration: none;
    }

    a:hover {
      background-color: var(--color-gray-alpha-72);
    }

    a:focus-visible {
      outline-color: var(--color-accent-contrast);
    }

    a[aria-current='page'] {
      background-color: var(--color-gray-alpha-56);
    }

    .nav-break {
      padding-left: var(--space-xs);
    }

    .join-link {
      font-style: italic;
      margin-top: var(--space-lg);
    }
  }
</style>
