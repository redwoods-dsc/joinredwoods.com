---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  aside?: boolean;
}

const { aside = true } = Astro.props;
---

<div class="global-wrap">
  <div class="shell" data-aside={String(aside)}>
    <div class="shell__header"><Header /></div>
    <div class="shell__main">
      <main class="main-wrap"><slot /></main>
    </div>
    {
      aside && (
        <aside class="shell__aside">
          <Sidebar />
        </aside>
      )
    }
    <div class="shell__footer"><Footer /></div>
  </div>
  <p class="copyright">&copy; 2026 Redwoods. Better humans. Better practitioners.</p>
</div>

<style>
  /* Breakpoints are raw px because custom properties can't be used in @media
     conditions: 850px adds the header rail, 1300px splits the aside off.
     1300 is a deliberate trade — the rail, aside, gaps and padding mean main
     only clears --layout-prose-max from ~1632px, so three columns on a laptop
     is bought at the cost of main sitting short of the measure. */

  .global-wrap {
    position: relative;
    anchor-name: --global-wrap;
    max-width: var(--layout-shell-max);
    margin-inline: auto;
    padding: var(--space-lg);
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'header'
      'main'
      'aside'
      'footer';
    gap: 0;
  }

  /* Without dropping the area, the track still renders as an empty cream card. */
  .shell[data-aside='false'] {
    grid-template-areas:
      'header'
      'main'
      'footer';
  }

  .shell__header {
    grid-area: header;
  }

  .shell__main,
  .shell__aside,
  .shell__footer {
    background-color: var(--color-bg);
  }

  .shell__aside,
  .shell__footer {
    overflow: hidden;
  }

  .shell__main {
    grid-area: main;
    /* clip, not hidden: `hidden` makes this a scroll container and traps the
       article's sticky table of contents in a box that never scrolls. */
    overflow: clip;
  }

  .main-wrap {
    padding: var(--space-xl);
  }

  .shell__aside {
    grid-area: aside;
  }

  .shell__footer {
    grid-area: footer;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }

  /* main, aside and footer join into one cream column: row-gap 0 so they meet flush. */
  @media (min-width: 850px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header aside'
        'header footer';
      column-gap: var(--space-lg);
      row-gap: 0;
    }

    /* Bottom corners stay square to meet the aside flush; rounding them takes
       a bite out of the column and exposes the page behind the seam. */
    .shell__main {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .shell[data-aside='false'] {
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  @media (min-width: 1300px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr var(--layout-aside);
      grid-template-areas:
        'header main aside'
        'header footer footer';
    }

    .shell__main,
    .shell__aside {
      border-radius: var(--radius-xl);
    }

    .shell__footer {
      margin-block-start: var(--space-lg);
      border-radius: var(--radius-xl);
    }

    .shell[data-aside='false'] {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  .copyright {
    position: fixed;
    /* Physical insets: writing-mode remaps the logical ones onto the rotated axis. */
    bottom: var(--space-lg);
    /* Anchored to the wrap, not the viewport — past --layout-shell-max the two
       part company and a viewport inset strands this in the gutter. The plain
       `right` is the fallback where anchor positioning is unsupported. */
    right: 0;
    right: anchor(--global-wrap right);
    padding-right: var(--space-3xs);
    margin: 0;
    writing-mode: vertical-rl;
    font-size: var(--font-size-caption);
  }
</style>
