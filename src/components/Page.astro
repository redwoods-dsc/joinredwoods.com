---
import Header from './Header.astro';
---

<div class="global-wrap">
  <div class="shell">
    <div class="shell__header"><Header /></div>
    <div class="shell__main">
      <main class="main-wrap"><slot /></main>
    </div>
    <aside class="shell__aside"><slot name="aside" /></aside>
  </div>
  <p class="copyright">&copy; 2026 Redwoods. Better humans. Better practitioners.</p>
</div>

<style>
  /* Layout breakpoints (raw px — custom properties cannot be used in @media conditions):
       850px  → single column → two equal columns, header fixed to viewport
       1400px → two equal columns → 2/3 + 1/3, header back in flow         */

  .global-wrap {
    position: relative;
    padding: var(--space-lg);
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'header'
      'main'
      'aside';
    gap: 0; /* header + main read as one joined card on mobile */
  }

  /* At tablet, .header is position: fixed; the cell collapses in flow but the
     column track is still allocated by grid-template-columns. */
  .shell__header {
    grid-area: header;
  }

  .shell__main {
    grid-area: main;
    overflow: hidden;
    background-color: var(--color-bg);
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }

  /* Shared semantic landmark and content padding for every page that consumes
     the shell. Per-page wrappers shouldn't repeat padding rules. */
  .main-wrap {
    padding: var(--space-xl);
  }

  .shell__aside {
    grid-area: aside;
    overflow: hidden;
    background-color: var(--color-bg);
    border-radius: var(--radius-xl);
    margin-block-start: var(--space-lg);
  }

  /* Tablet: main + aside join into one cream column on the right (column-gap
     between left/right, row-gap 0 so the two cards meet flush). */
  @media (min-width: 850px) {
    .shell {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'header main'
        'header aside';
      column-gap: var(--space-lg);
      row-gap: 0;
    }

    .shell__main {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .shell__aside {
      border-radius: 0 0 var(--radius-xl) var(--radius-xl);
      margin-block-start: 0;
    }
  }

  /* Desktop: layout reflows so header + main are the joined column on the left,
     and aside is its own standalone card on the right (spans both rows). */
  @media (min-width: 1400px) {
    .shell {
      grid-template-columns: 2fr 1fr;
      grid-template-areas:
        'header aside'
        'main aside';
    }

    .shell__main {
      border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    }

    .shell__aside {
      border-radius: var(--radius-xl);
    }
  }

  .copyright {
    position: fixed;
    /* Physical bottom/right: writing-mode remaps logical insets, so logical
       props here would resolve against the rotated axis and mis-place the text. */
    bottom: var(--space-lg);
    right: var(--space-3xs);
    margin: 0;
    writing-mode: vertical-rl;
    /* TODO: revisit when the typography scale is reworked — a "caption" size
       between xs and sm would belong here. */
    font-size: 14px;
  }
</style>
