---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  aside?: boolean;
}

const { aside = true } = Astro.props;
---

<div class="global-wrap">
  <div class="shell" data-aside={String(aside)}>
    <div class="shell__header"><Header /></div>
    <div class="shell__main">
      <main class="main-wrap"><slot /></main>
    </div>
    {
      aside && (
        <aside class="shell__aside">
          <Sidebar />
        </aside>
      )
    }
    <div class="shell__footer"><Footer /></div>
  </div>
  <p class="copyright">&copy; 2026 Redwoods. Better humans. Better practitioners.</p>
</div>

<style>
  /* Breakpoints are raw px because custom properties can't be used in @media
     conditions: 850 adds the rail, 1000 lies it down into a band, 1300 stands it
     back up as a third column. The band is bounded both sides so neither rail
     state needs undoing, .98 so no width falls between two blocks. The cost of
     the 1300 split is in the style guide's Layout section. */

  .global-wrap {
    position: relative;
    anchor-name: --global-wrap;
    max-width: var(--layout-shell-max);
    margin-inline: auto;
    padding: var(--space-lg);
  }

  /* The wrap's padding is in normal flow, so the band above and below the cards
     scrolls away with them and the cards meet the viewport's edge. These hold
     that gap open at both ends. Only top and bottom: the inline padding never
     scrolls, and a full border would paint over the copyright in the right
     gutter. Painted from the same token as the body, so the held-open gap and
     the ground it continues are the same colour. */
  .global-wrap::before,
  .global-wrap::after {
    content: '';
    position: fixed;
    inset-inline: 0;
    height: var(--space-lg);
    background-color: var(--color-gray-100);
    pointer-events: none;
    /* The only z-index in the codebase. ::before would otherwise paint under
       every positioned sibling, and the sticky sidebar takes a negative `top`
       once it outgrows the viewport — it rises into the band and would cover
       it. Raising both keeps the pair symmetrical rather than fixing one. */
    z-index: 1;
  }

  .global-wrap::before {
    top: 0;
  }

  .global-wrap::after {
    bottom: 0;
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'header'
      'main'
      'aside'
      'footer';
    gap: var(--space-lg);
  }

  /* Without dropping the area, the track still renders as an empty cream card. */
  .shell[data-aside='false'] {
    grid-template-areas:
      'header'
      'main'
      'footer';
  }

  .shell__header {
    grid-area: header;
  }

  .shell__main,
  .shell__aside,
  .shell__footer {
    background-color: var(--color-bg);
    border-radius: var(--radius-xl);
    /* Without this the track takes its content's min-content width: `clip` below
       isn't a scroll container, so it doesn't zero the automatic minimum, and one
       long code line widened the whole shell past the viewport. */
    min-width: 0;
  }

  .shell__main {
    grid-area: main;
    /* clip, not hidden: `hidden` makes this a scroll container and traps the
       article's sticky table of contents in a box that never scrolls. */
    overflow: clip;
  }

  .shell__aside {
    grid-area: aside;
    /* clip for the same reason as main: the sidebar sticks inside this. */
    overflow: clip;
  }

  .shell__footer {
    grid-area: footer;
    overflow: hidden;
  }

  .main-wrap {
    padding: var(--space-lg);
  }

  /* The rail is viewport-height whether the page fills it or not; without this a
     short page leaves the page showing through beside it. The 1fr rows below put
     the slack above the footer rather than into it. */
  @media (min-width: 850px) and (max-width: 999.98px), (min-width: 1300px) {
    .shell {
      min-height: var(--layout-rail-height);
    }
  }

  @media (min-width: 850px) and (max-width: 999.98px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr;
      /* Slack goes to main: on the aside it would show as empty cream below a
         sidebar that has run out of content. */
      grid-template-rows: 1fr auto auto;
      grid-template-areas:
        'header main'
        'header aside'
        'header footer';
    }

    .shell[data-aside='false'] {
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  @media (min-width: 1000px) {
    /* Painted on .sidebar from here, which is the sticky box — a background left
       on this track scrolls out from under its own contents. */
    .shell__aside {
      background-color: transparent;
    }
  }

  @media (min-width: 1000px) and (max-width: 1299.98px) {
    .shell {
      grid-template-columns: 1fr var(--layout-aside);
      grid-template-areas:
        'header header'
        'main   aside'
        'footer footer';
    }

    /* Columns go with the area, or a 30% track is left holding nothing. */
    .shell[data-aside='false'] {
      grid-template-columns: 1fr;
      grid-template-areas:
        'header'
        'main'
        'footer';
    }
  }

  @media (min-width: 1300px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr var(--layout-aside);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'header main aside'
        'header footer footer';
    }

    .shell[data-aside='false'] {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  .copyright {
    position: fixed;
    /* Physical insets: writing-mode remaps the logical ones onto the rotated axis. */
    bottom: var(--space-lg);
    /* Anchored to the wrap, not the viewport — past --layout-shell-max the two
       part company and a viewport inset strands this in the gutter. The plain
       `right` is the fallback where anchor positioning is unsupported. */
    right: 0;
    right: anchor(--global-wrap right);
    padding-right: var(--space-3xs);
    margin: 0;
    writing-mode: vertical-rl;
    font-size: var(--font-size-caption);
  }
</style>
