---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  aside?: boolean;
}

const { aside = true } = Astro.props;
---

<div class="global-wrap">
  <div class="shell" data-aside={String(aside)}>
    <div class="shell__header"><Header /></div>
    <div class="shell__main">
      <main class="main-wrap"><slot /></main>
    </div>
    {
      aside && (
        <aside class="shell__aside">
          <Sidebar />
        </aside>
      )
    }
    <div class="shell__footer"><Footer /></div>
  </div>
  <p class="copyright">&copy; 2026 Redwoods. Better humans. Better practitioners.</p>
</div>

<style>
  /* Layout breakpoints (raw px — custom properties cannot be used in @media conditions):
       850px  → stacked → header rail + one joined content column
       1650px → aside leaves the joined column and becomes a third column

     1650 is derived, not chosen: the rail, the aside and the gaps take
     --layout-rail + --layout-aside + 3 × --space-lg + 2 × --space-xl of
     padding, so main only clears --layout-prose-max from about 1632px up.
     Splitting the aside off any earlier buys a third column by squeezing the
     reading measure, which is the trade this layout exists to avoid. Changing
     either width moves this number — recompute it, don't nudge it. */

  .global-wrap {
    position: relative;
    max-width: var(--layout-shell-max);
    margin-inline: auto;
    padding: var(--space-lg);
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'header'
      'main'
      'aside'
      'footer';
    gap: 0; /* header + main + aside + footer read as one joined column on mobile */
  }

  /* Pages that opt out of the aside drop its row/column entirely. Without this
     the track is still allocated and renders as an empty cream card. */
  .shell[data-aside='false'] {
    grid-template-areas:
      'header'
      'main'
      'footer';
  }

  /* At tablet, .header is position: fixed; the cell collapses in flow but the
     column track is still allocated by grid-template-columns. */
  .shell__header {
    grid-area: header;
  }

  /* Cream cards share the same surface and clip to their rounded corners. The
     column they belong to changes per breakpoint (see the joining radii below),
     so radius is set contextually rather than here. */
  .shell__main,
  .shell__aside,
  .shell__footer {
    background-color: var(--color-bg);
  }

  .shell__aside,
  .shell__footer {
    overflow: hidden;
  }

  .shell__main {
    grid-area: main;
    /* clip rather than hidden: `hidden` makes this a scroll container, which
       traps any sticky descendant (the article table of contents) in a box
       that never scrolls. `clip` still clips to the joining radii. */
    overflow: clip;
  }

  /* Shared semantic landmark and content padding for every page that consumes
     the shell. Per-page wrappers shouldn't repeat padding rules. */
  .main-wrap {
    padding: var(--space-xl);
    /* Establishes the query container the hero sizes against, so display type
       responds to this column's width rather than the viewport. */
    container: main / inline-size;
  }

  .shell__aside {
    grid-area: aside;
  }

  .shell__footer {
    grid-area: footer;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }

  /* Tablet: main + aside + footer join into one cream column on the right
     (column-gap between left/right, row-gap 0 so the cards meet flush). */
  @media (min-width: 850px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header aside'
        'header footer';
      column-gap: var(--space-lg);
      row-gap: 0;
    }

    /* main, aside and footer are still one joined column here, so main keeps
       its bottom corners square to meet the aside's flush top edge. Rounding
       all four takes a bite out of the column at the seam — the two cards are
       the same cream, but the corner exposes the page behind them. */
    .shell__main {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    /* Header stays fixed to the left column here, so keep both tracks and just
       let main + footer share the right one. */
    .shell[data-aside='false'] {
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  /* Aside becomes its own column, so the three cards separate: each one is
     free-standing and fully rounded, and the footer drops below both. */
  @media (min-width: 1650px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr var(--layout-aside);
      grid-template-areas:
        'header main aside'
        'header footer footer';
    }

    .shell__main,
    .shell__aside {
      border-radius: var(--radius-xl);
    }

    .shell__footer {
      margin-block-start: var(--space-lg);
      border-radius: var(--radius-xl);
    }

    /* No aside to split off, so the third track would be dead space. Drop back
       to the rail + content pair; main and footer stay separate cards. */
    .shell[data-aside='false'] {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  .copyright {
    position: fixed;
    /* Physical bottom/right: writing-mode remaps logical insets, so logical
       props here would resolve against the rotated axis and mis-place the text. */
    bottom: var(--space-lg);
    right: var(--space-3xs);
    margin: 0;
    writing-mode: vertical-rl;
    font-size: var(--font-size-caption);
  }
</style>
