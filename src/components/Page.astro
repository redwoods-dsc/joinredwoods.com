---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  aside?: boolean;
}

const { aside = true } = Astro.props;
---

<div class="global-wrap">
  <div class="shell" data-aside={String(aside)}>
    <div class="shell__header"><Header /></div>
    <div class="shell__main">
      <main class="main-wrap"><slot /></main>
    </div>
    {
      aside && (
        <aside class="shell__aside">
          <Sidebar />
        </aside>
      )
    }
    <div class="shell__footer"><Footer /></div>
  </div>
  <p class="copyright">&copy; 2026 Redwoods. Better humans. Better practitioners.</p>
</div>

<style>
  /* Breakpoints are raw px because custom properties can't be used in @media
     conditions: 850 adds the header rail, 1000 lies it down into a band so the
     aside can sit beside main instead of under it, 1300 stands it back up as a
     third column. The band is bounded on both sides, so the rail states either
     side of it need no undoing — .98 rather than a whole pixel so no width
     falls between two blocks. The cost of the 1300 split is documented in the
     style guide's Layout section. */

  .global-wrap {
    position: relative;
    anchor-name: --global-wrap;
    max-width: var(--layout-shell-max);
    margin-inline: auto;
    padding: var(--space-lg);
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'header'
      'main'
      'aside'
      'footer';
    gap: 0;
  }

  /* Without dropping the area, the track still renders as an empty cream card. */
  .shell[data-aside='false'] {
    grid-template-areas:
      'header'
      'main'
      'footer';
  }

  .shell__header {
    grid-area: header;
  }

  .shell__main,
  .shell__aside,
  .shell__footer {
    background-color: var(--color-bg);
  }

  .shell__footer {
    overflow: hidden;
  }

  /* clip, not hidden, for the same reason as .shell__main below: `hidden`
     makes this a scroll container, and the sidebar sticks inside it. */
  .shell__aside {
    overflow: clip;
  }

  .shell__main {
    grid-area: main;
    /* clip, not hidden: `hidden` makes this a scroll container and traps the
       article's sticky table of contents in a box that never scrolls. */
    overflow: clip;
  }

  .main-wrap {
    padding: var(--space-lg);
  }

  .shell__aside {
    grid-area: aside;
  }

  .shell__footer {
    grid-area: footer;
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  }

  /* main, aside and footer join into one cream column: row-gap 0 so they meet flush. */
  @media (min-width: 850px) and (max-width: 999.98px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header aside'
        'header footer';
      column-gap: var(--space-lg);
      row-gap: 0;
    }

    /* Bottom corners stay square to meet the aside flush; rounding them takes
       a bite out of the column and exposes the page behind the seam. */
    .shell__main {
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }

    .shell[data-aside='false'] {
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  /* From here up the cards stand free in both the band and the three-column
     state, and only the tracks under them differ. */
  @media (min-width: 1000px) {
    .shell {
      gap: var(--space-lg);
    }

    .shell__main,
    .shell__aside,
    .shell__footer {
      border-radius: var(--radius-xl);
    }
  }

  @media (min-width: 1000px) and (max-width: 1299.98px) {
    .shell {
      grid-template-columns: 1fr var(--layout-aside);
      grid-template-areas:
        'header header'
        'main   aside'
        'footer footer';
    }

    /* The columns go with the area: dropping the area alone leaves a 30% track
       holding nothing. */
    .shell[data-aside='false'] {
      grid-template-columns: 1fr;
      grid-template-areas:
        'header'
        'main'
        'footer';
    }
  }

  @media (min-width: 1300px) {
    .shell {
      grid-template-columns: var(--layout-rail) 1fr var(--layout-aside);
      grid-template-areas:
        'header main aside'
        'header footer footer';
    }

    .shell[data-aside='false'] {
      grid-template-columns: var(--layout-rail) 1fr;
      grid-template-areas:
        'header main'
        'header footer';
    }
  }

  .copyright {
    position: fixed;
    /* Physical insets: writing-mode remaps the logical ones onto the rotated axis. */
    bottom: var(--space-lg);
    /* Anchored to the wrap, not the viewport — past --layout-shell-max the two
       part company and a viewport inset strands this in the gutter. The plain
       `right` is the fallback where anchor positioning is unsupported. */
    right: 0;
    right: anchor(--global-wrap right);
    padding-right: var(--space-3xs);
    margin: 0;
    writing-mode: vertical-rl;
    font-size: var(--font-size-caption);
  }
</style>
