---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['button-row', className]}><slot /></div>

<style>
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    /* A div breaks base.css's prose adjacency chains (p + p, ul + p), so the
       row carries its own margin and collapses to the same gap. */
    margin-block: var(--space-md);
  }
</style>
