---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { Member } from '../lib/members';

type Props = Member;

const { name, title, linkedin, website, avatar } = Astro.props;

/* Resolved here rather than imported by name, because the filename comes out of
   Slack — the same move ContentPage makes for its heading artwork. Every file in
   this folder belongs to a listed member, so the eager glob wastes nothing. */
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/members/*.{jpg,png,gif,webp}',
  { eager: true },
);

const found = avatar
  ? Object.entries(photos).find(([path]) => path.endsWith(`/${avatar}`))
  : undefined;

/* 2× a 64px circle. Squared off first: Slack does not promise one. */
const photo = found
  ? await getImage({ src: found[1].default, format: 'webp', width: 128, height: 128, fit: 'cover' })
  : undefined;
---

<li class="member">
  <div class="member__photo">
    {photo && <img src={photo.src} alt="" width="64" height="64" loading="lazy" decoding="async" />}
  </div>
  <div class="member__body">
    <p class="member__name">{name}</p>
    {title && <p class="member__title">{title}</p>}
    {
      (linkedin || website) && (
        <p class="member__links">
          {linkedin && (
            <a href={linkedin} aria-label={`${name} on LinkedIn`}>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C21.6 8.65 22 11.1 22 14.3V21h-4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.96 0-2.26 1.53-2.26 3.1V21h-4V9Z" />
              </svg>
            </a>
          )}
          {website && (
            <a href={website} aria-label={`${name}'s website`}>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18" />
              </svg>
            </a>
          )}
        </p>
      )
    }
  </div>
</li>

<style>
  .member {
    display: flex;
    gap: var(--space-md);
    align-items: start;
    list-style: none;
  }

  /* Held even when there is no photo, so the names line up across a row rather
     than stepping left for the members who have never set one. */
  .member__photo {
    flex: none;
    width: 64px;
    height: 64px;
  }

  .member__photo img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .member__body {
    min-width: 0;
  }

  .member__name {
    margin: 0;
    font-weight: var(--font-weight-semibold);
  }

  .member__title {
    margin: var(--space-3xs) 0 0;
    font-size: var(--font-size-sm);
  }

  .member__links {
    display: flex;
    gap: var(--space-xs);
    margin: var(--space-xs) 0 0;
  }

  .member__links a {
    display: inline-flex;
    line-height: 0;
  }
</style>
