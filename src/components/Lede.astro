<div class="lede"><slot /></div>

<style>
  /* The opening block runs at display size, so it replaces base.css's prose
     adjacency spacing with a looser scale of its own. flow-root keeps the last
     child's margin from collapsing through, so the gap below stays this
     element's own margin at every width. */
  .lede {
    display: flow-root;
    margin-block-end: var(--space-2xl);
  }

  /* Stated here rather than left to the child: a layout's prose rhythm reaches
     slotted content through :global() at a higher specificity than the child's
     own reset, so a Hero that already zeroes its margin still gets pushed down. */
  .lede > :global(:first-child) {
    margin-block-start: 0;
  }

  .lede > :global(* + *) {
    margin-block-start: var(--space-lg);
  }

  .lede > :global(blockquote) {
    margin-block-start: var(--space-xl);
  }

  /* This block owns the gap below it, so neither edge adds a margin on top. */
  .lede > :global(:last-child) {
    margin-block-end: 0;
  }

  .lede + :global(*) {
    margin-block-start: 0;
  }
</style>
