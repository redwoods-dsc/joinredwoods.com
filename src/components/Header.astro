---
import redwoodsLogo from '../assets/redwoods-logo-white.svg';
import tagline from '../assets/tagline-white.svg';
import { headerBackground } from '../lib/header-background';
import NavLink from '../components/NavLink.astro';

const background = await headerBackground();
---

<header class="header" style={`--bg-image: url(${background.src})`}>
  <div class="header-content">
    <h1 class="logo-heading">
      <a class="logo" href="/"
        ><img
          src={redwoodsLogo.src}
          width={redwoodsLogo.width}
          height={redwoodsLogo.height}
          alt="Redwoods"
        /></a
      >
    </h1>
    <nav class="nav" role="navigation">
      <ul>
        <li><NavLink href="/" exact>Home</NavLink></li>
        <li><NavLink href="/field-notes/">Field Notes</NavLink></li>
        <li class="nav-break">—</li>
        <li class="nav-join"><NavLink href="/join" class="join-link">Join</NavLink></li>
      </ul>
    </nav>
    <img
      src={tagline.src}
      width={tagline.width}
      height={tagline.height}
      alt="A design system community"
      class="tagline"
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    height: 50vh;
    min-height: var(--layout-header-min);
    padding: var(--space-lg);
    color: var(--color-accent-contrast);
    --selection-bg: var(--color-accent-contrast);
    --selection-fg: var(--color-accent);
    /* Load-bearing: the trees image is pre-composited onto this exact colour
       (see lib/header-background.ts) and only stays seamless while they match. */
    background-color: var(--color-accent);
    /* URL comes in via --bg-image so Astro's pipeline emits the file — a bare
       url('../assets/…') compiles to a path the production build never writes. */
    background-image: var(--bg-image);
    background-repeat: no-repeat;
    background-position-y: var(--space-xl);
    background-position-x: var(--space-4xl);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  @media (min-height: 1024px) {
    .header {
      background-position-y: bottom;
    }
  }

  /* The card becomes the fixed rail. Top and left fall out of the static
     position, but a fixed box shrink-to-fits, so width has to be restated —
     from the same token the grid track reads. Stated once for two ranges: the
     band between them is in normal flow. */
  @media (min-width: 850px) and (max-width: 999.98px), (min-width: 1300px) {
    .header {
      position: fixed;
      width: var(--layout-rail);
      height: var(--layout-rail-height);
      border-radius: var(--radius-xl);
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .logo-heading {
    margin: 0;
    align-self: flex-start;
  }

  .logo {
    display: block;
    width: 190px;
    line-height: 0;
    margin: 0;
    padding: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
  }

  .nav {
    font-size: var(--font-size-md);
    /* Cancels the padding NavLink puts on the anchor so the labels still line
       up with the logo above them. */
    margin-inline-start: calc(-1 * var(--space-xs));
  }

  .nav ul {
    padding-inline-start: 0;
  }

  .nav li {
    list-style: none;
  }

  .nav-break {
    padding-inline-start: var(--space-xs);
  }

  /* On the list item: the anchor is inline, and vertical margins don't apply
     to an inline box. */
  .nav-join {
    margin-block-start: var(--space-lg);
  }

  /* NavLink renders the anchor, so it carries that component's hash rather
     than this one's — :global() is what lets a rule here reach it, and .nav
     keeps it from escaping the header. */
  .nav :global(.join-link) {
    font-style: italic;
  }

  /* 300 is --layout-rail minus the card's padding; past it the artwork overflows
     the rail. */
  .tagline {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-block-start: auto;
    align-self: flex-start;
  }

  .logo:focus-visible {
    outline-color: var(--color-accent-contrast);
  }

  @media (min-width: 1000px) and (max-width: 1299.98px) {
    .header {
      /* Meets the base rule's min-height, so the card lands exactly here. */
      max-height: var(--layout-header-min);
      border-radius: var(--radius-xl);
      /* Restated so the min-height: 1024px flip can't swap canopy for trunks. */
      background-position: right var(--space-xl);
    }
  }
</style>
