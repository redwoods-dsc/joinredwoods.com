---
import redwoodsLogo from '../assets/redwoods-logo-white.svg';
import tagline from '../assets/tagline-white.svg';
import { headerBackground } from '../lib/header-background';

const background = await headerBackground();
---

<header class="header" style={`--bg-image: url(${background.src})`}>
  <div class="header-content">
    <h1 class="logo-heading">
      <a class="logo" href="/"
        ><img
          src={redwoodsLogo.src}
          width={redwoodsLogo.width}
          height={redwoodsLogo.height}
          alt="Redwoods"
        /></a
      >
    </h1>
    <nav class="nav" role="navigation">
      <ul>
        <li><a href="/field-notes/">Field Notes</a></li>
        <li>-</li>
        <li><a class="join-link" href="/join">Join</a></li>
      </ul>
    </nav>
    <img
      src={tagline.src}
      width={tagline.width}
      height={tagline.height}
      alt="A design system community"
      class="tagline"
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    height: 50vh;
    min-height: 360px;
    padding: var(--space-lg);
    color: var(--color-accent-contrast);
    /* Load-bearing: the trees image is pre-composited onto this exact colour
       (see lib/header-background.ts) so it can drop its alpha channel, and it
       only stays seamless while the card behind it matches. */
    background-color: var(--color-accent);
    /* URL comes from an ESM import (see the frontmatter) via --bg-image so
       Astro's pipeline reliably emits the file; a bare url('../assets/…') here
       compiles to a hashed path that never gets written in the production build.
       Media-query background-position logic below stays in CSS. */
    background-image: var(--bg-image);
    background-repeat: no-repeat;
    background-position-y: var(--space-xl);
    background-position-x: var(--space-4xl);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  /* tall viewports — anchor the trees to the card bottom */
  @media (min-height: 1024px) {
    .header {
      background-position-y: bottom;
    }
  }

  /* very short viewports — drop the trees so the nav has room to breathe */
  @media (max-height: 400px) {
    .header {
      background-image: none;
    }
  }

  /* 850px+ — the card leaves the stack and becomes the rail: free-standing in
     its own column, so fully rounded, and pinned to the viewport for the whole
     of the rail's life. Top and left are left to the static position — the grid
     cell it would have occupied — so only the width has to be restated, and it
     reads the same token the track does. Leaving width to shrink-to-fit sizes
     the card from the tagline instead, which lands a couple of pixels off. */
  @media (min-width: 850px) {
    .header {
      position: fixed;
      width: var(--layout-rail);
      height: calc(100dvh - 2 * var(--space-lg));
      border-radius: var(--radius-xl);
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .logo-heading {
    margin: 0;
    align-self: flex-start;
  }

  .logo {
    display: block;
    width: 190px;
    line-height: 0;
    margin: 0;
    padding: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
  }

  /* max-width has to stay under --layout-rail minus the card's padding, or the
     artwork overflows the rail once the card stops sizing itself to fit. */
  .tagline {
    width: 80%;
    max-width: 300px;
    height: auto;
    margin-block-start: auto;
    align-self: flex-start;
  }

  @media (min-width: 740px) {
    .tagline {
      width: auto;
      align-self: flex-end;
    }
  }

  @media (min-width: 850px) {
    .tagline {
      align-self: flex-start;
    }
  }

  .nav {
    font-size: var(--font-size-md);
  }

  .nav ul {
    padding-inline-start: 0;
  }

  .nav li {
    list-style: none;
  }

  .nav a {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-contrast);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .logo:focus-visible,
  .nav a:focus-visible {
    outline-color: var(--color-accent-contrast);
  }

  .join-link {
    font-style: italic;
  }
</style>
