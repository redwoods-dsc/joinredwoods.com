---
import redwoodsLogo from '../assets/redwoods-logo-white.svg';
import tagline from '../assets/tagline-white.svg';
import { headerBackground } from '../lib/header-background';

const background = await headerBackground();
---

<header class="header" style={`--bg-image: url(${background.src})`}>
  <div class="header-content">
    <h1 class="logo-heading">
      <a class="logo" href="/"
        ><img
          src={redwoodsLogo.src}
          width={redwoodsLogo.width}
          height={redwoodsLogo.height}
          alt="Redwoods"
        /></a
      >
    </h1>
    <nav class="nav" role="navigation">
      <ul>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="#">The Quarterly</a></li>
        <li><a href="#">Members</a></li>
        <li>-</li>
        <li><a class="join-link" href="/join">Join</a></li>
      </ul>
    </nav>
    <img
      src={tagline.src}
      width={tagline.width}
      height={tagline.height}
      alt="A design system community"
      class="tagline"
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    height: 50vh;
    min-height: 360px;
    padding: var(--space-lg);
    color: var(--color-accent-contrast);
    background-color: var(--color-accent);
    /* URL comes from an ESM import (see the frontmatter) via --bg-image so
       Astro's pipeline reliably emits the file; a bare url('../assets/…') here
       compiles to a hashed path that never gets written in the production build.
       Media-query background-position logic below stays in CSS. */
    background-image: var(--bg-image);
    background-repeat: no-repeat;
    background-position-y: var(--space-xl);
    background-position-x: var(--space-4xl);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  /* tall viewports — anchor the trees to the card bottom */
  @media (min-height: 1024px) {
    .header {
      background-position-y: bottom;
    }
  }

  /* very short viewports — drop the trees so the nav has room to breathe */
  @media (max-height: 400px) {
    .header {
      background-image: none;
    }
  }

  /* 850px+ — header card sits in its own column. Fully rounded by default
     (the desktop block below re-flattens the bottom corners when header
     rejoins main beneath it in the left column). */
  @media (min-width: 850px) {
    .header {
      border-radius: var(--radius-xl);
    }
  }

  /* Tablet — fixed card pinned to the viewport. Width matches the left grid
     column: (shell − gap) ÷ 2, where shell = 100vw − 2 × --space-lg. */
  @media (min-width: 850px) and (max-width: 1399.98px) {
    .header {
      position: fixed;
      width: calc((100vw - 3 * var(--space-lg)) / 2);
      height: calc(100dvh - 2 * var(--space-lg));
    }
  }

  /* Desktop — header rejoins main below it in the left column, so back to
     top-only border-radius to meet main's bottom-only flush. Height returns
     to auto so the card sizes from its content (logo + nav); the absolute
     tagline below then lands cleanly on the nav's bottom baseline. */
  @media (min-width: 1400px) {
    .header {
      height: auto;
      min-height: 0;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      background-position-x: center;
      background-position-y: top;
    }
  }

  @media (min-width: 1400px) and (min-height: 650px) {
    .header {
      min-height: 420px;
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .logo-heading {
    margin: 0;
    align-self: flex-start;
  }

  .logo {
    display: block;
    width: 190px;
    line-height: 0;
    margin: 0;
    padding: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
  }

  .tagline {
    width: 80%;
    max-width: 350px;
    height: auto;
    margin-block-start: auto;
    align-self: flex-start;
  }

  @media (min-width: 740px) {
    .tagline {
      width: auto;
      align-self: flex-end;
    }
  }

  @media (min-width: 850px) {
    .tagline {
      align-self: flex-start;
    }
  }

  /* Desktop — tagline breaks out of the column flow so it sits on the same
     baseline as the bottom of the nav, anchored to the right of the card. */
  @media (min-width: 1400px) {
    .tagline {
      position: absolute;
      right: var(--space-lg);
      bottom: var(--space-lg);
      margin-block-start: 0;
    }
  }

  .nav {
    font-size: var(--font-size-md);
  }

  .nav ul {
    padding-inline-start: 0;
  }

  .nav li {
    list-style: none;
  }

  .nav a {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-contrast);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .logo:focus-visible,
  .nav a:focus-visible {
    outline-color: var(--color-accent-contrast);
  }

  .join-link {
    font-style: italic;
  }
</style>
