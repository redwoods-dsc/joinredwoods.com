---
import redwoodsLogo from '../assets/redwoods-logo-white.svg';
import tagline from '../assets/tagline-white.svg';
import { headerBackground } from '../lib/header-background';

const background = await headerBackground();
---

<header class="header" style={`--bg-image: url(${background.src})`}>
  <div class="header-content">
    <h1 class="logo-heading">
      <a class="logo" href="/"
        ><img
          src={redwoodsLogo.src}
          width={redwoodsLogo.width}
          height={redwoodsLogo.height}
          alt="Redwoods"
        /></a
      >
    </h1>
    <nav class="nav" role="navigation">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/field-notes/">Field Notes</a></li>
        <li>-</li>
        <li><a class="join-link" href="/join">Join</a></li>
      </ul>
    </nav>
    <img
      src={tagline.src}
      width={tagline.width}
      height={tagline.height}
      alt="A design system community"
      class="tagline"
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    height: 50vh;
    min-height: 360px;
    padding: var(--space-lg);
    color: var(--color-accent-contrast);
    /* Load-bearing: the trees image is pre-composited onto this exact colour
       (see lib/header-background.ts) and only stays seamless while they match. */
    background-color: var(--color-accent);
    /* URL comes in via --bg-image so Astro's pipeline emits the file — a bare
       url('../assets/…') compiles to a path the production build never writes. */
    background-image: var(--bg-image);
    background-repeat: no-repeat;
    background-position-y: var(--space-xl);
    background-position-x: var(--space-4xl);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  @media (min-height: 1024px) {
    .header {
      background-position-y: bottom;
    }
  }

  /* Drop the trees so the nav has room to breathe. */
  @media (max-height: 400px) {
    .header {
      background-image: none;
    }
  }

  /* The card becomes the fixed rail. Top and left fall out of the static
     position, but a fixed box shrink-to-fits, so width has to be restated —
     from the same token the grid track reads. */
  @media (min-width: 850px) {
    .header {
      position: fixed;
      width: var(--layout-rail);
      height: calc(100dvh - 2 * var(--space-lg));
      border-radius: var(--radius-xl);
    }
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .logo-heading {
    margin: 0;
    align-self: flex-start;
  }

  .logo {
    display: block;
    width: 190px;
    line-height: 0;
    margin: 0;
    padding: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
  }

  /* Stay under --layout-rail minus the card's padding, or the artwork overflows. */
  .tagline {
    width: 80%;
    max-width: 300px;
    height: auto;
    margin-block-start: auto;
    align-self: flex-start;
  }

  @media (min-width: 740px) {
    .tagline {
      width: auto;
      align-self: flex-end;
    }
  }

  @media (min-width: 850px) {
    .tagline {
      align-self: flex-start;
    }
  }

  .nav {
    font-size: var(--font-size-md);
  }

  .nav ul {
    padding-inline-start: 0;
  }

  .nav li {
    list-style: none;
  }

  .nav a {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-contrast);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .logo:focus-visible,
  .nav a:focus-visible {
    outline-color: var(--color-accent-contrast);
  }

  .join-link {
    font-style: italic;
  }
</style>
