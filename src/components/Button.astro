---
import { inlineSlot } from '../lib/inline-slot';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

// A label is phrasing content, so the slot can't carry the paragraph MDX wraps
// it in — a block box inside this inline-flex row breaks the button's layout.
// See inlineSlot.
const label = await inlineSlot(Astro.slots);
---

<Tag
  class:list={['btn', className]}
  data-variant={variant}
  data-size={size}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
  {...rest}
  set:html={label}
/>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .btn:where(:not(:disabled, [aria-disabled='true'])):active {
    transform: translateY(1px);
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn[data-size='sm'] {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-sm);
  }

  .btn[data-size='md'] {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-base);
  }

  .btn[data-size='lg'] {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--font-size-md);
  }

  .btn[data-variant='primary'] {
    background-color: var(--color-blue);
    color: var(--color-surface-contrast);
  }

  .btn[data-variant='primary']:where(:not(:disabled, [aria-disabled='true'])):hover {
    background-color: color-mix(in srgb, var(--color-blue) 85%, var(--color-gray-00));
  }

  /* Sits at the page colour rather than on it, so at rest the border is what
     draws the button and the fill stays out of the way. --color-bg rather than
     --color-cream: it should follow the page, not a particular colour.

     Which puts the whole boundary on the border, so it takes gray-50 rather
     than --color-border. That token is 1.40:1 against the page — fine for the
     rules and separators it draws elsewhere, which 1.4.11 doesn't govern, but
     short of the 3:1 a control's edge is asked for. gray-50 clears it on both
     fills: 3.08:1 at rest, 3.54:1 hovered. */
  .btn[data-variant='secondary'] {
    background-color: var(--color-bg);
    color: var(--color-text);
    border-color: var(--color-gray-50);
  }

  /* Lifts off the page instead of pressing into it: the fill brightens past the
     background rather than darkening below it, which is the direction that
     reads as "this responds". Label contrast rises with it, 8.46:1 to 9.74:1.

     No border-color here — the rule this replaced set --color-gray-75, which is
     what --color-border already resolves to. */
  .btn[data-variant='secondary']:where(:not(:disabled, [aria-disabled='true'])):hover {
    background-color: var(--color-gray-100);
  }

  .btn[data-variant='ghost'] {
    background-color: transparent;
    color: var(--color-text);
  }

  .btn[data-variant='ghost']:where(:not(:disabled, [aria-disabled='true'])):hover {
    background-color: var(--color-surface);
    color: var(--color-surface-contrast);
  }

  .btn[data-variant='danger'] {
    background-color: #b91c1c;
    color: var(--color-gray-100);
  }

  .btn[data-variant='danger']:where(:not(:disabled, [aria-disabled='true'])):hover {
    background-color: #991b1b;
  }
</style>
