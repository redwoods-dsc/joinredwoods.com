---
import { getCollection } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';

const articles = (await getCollection('field-notes', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<ContentPage
  title="Field Notes"
  headingImage="_field-notes.png"
  subtitle="Redwoods is committed to analyzing and synthesizing the things we learn. Everything here is offered back to the wider design system community, freely."
  note="Anything drawn from inside Redwoods is anonymized first, out of respect for the trust that makes hard conversations possible."
  description="Analysis and synthesis from the Redwoods community, offered back to the wider design system world."
>
  <ul class="article-list">
    {
      articles.map((article) => (
        <li>
          <h2>
            <a href={`/field-notes/${article.id}/`}>{article.data.title}</a>
          </h2>
          {article.data.description && <p>{article.data.description}</p>}
          <div class="meta">
            <span class="authors">{article.data.authors.join(', ')}</span>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </div>
        </li>
      ))
    }
  </ul>
</ContentPage>

<style>
  .article-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .article-list h2 {
    margin: 0;
  }

  .article-list p {
    margin: var(--space-xs) 0 0;
  }

  .article-list .meta {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
</style>
