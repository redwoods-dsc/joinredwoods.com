---
import { getCollection } from 'astro:content';
import ContentPage from '../../../layouts/ContentPage.astro';
import BackLink from '../../../components/BackLink.astro';
import { authorSlug } from '../../../lib/authors';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (entry) => !entry.data.draft);
  const authorMap = new Map<string, string>();
  for (const article of articles) {
    for (const author of article.data.authors) {
      authorMap.set(authorSlug(author), author);
    }
  }
  return [...authorMap.entries()].map(([slug, name]) => ({
    params: { slug },
    props: { name },
  }));
}

const { name } = Astro.props;

const allArticles = await getCollection('articles', (entry) => !entry.data.draft);
const articles = allArticles
  .filter((a) => a.data.authors.includes(name))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<ContentPage title={name}>
  <BackLink slot="breadcrumb" href="/field-notes/">Back to Field Notes</BackLink>
  <p class="bio">
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
    labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco
    laboris.
  </p>
  <h2>Articles</h2>
  <ul class="article-list">
    {
      articles.map((article) => (
        <li>
          <a href={`/field-notes/${article.id}/`}>{article.data.title}</a>
          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
        </li>
      ))
    }
  </ul>
</ContentPage>

<style>
  .bio {
    margin-block-end: var(--space-lg);
    color: var(--color-text);
  }

  .article-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .article-list time {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
</style>
