---
import { getCollection, render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import BackLink from '../../components/BackLink.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { authorSlug } from '../../lib/authors';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (entry) => !entry.data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Transform headings to include slugs
const headingsWithSlugs = headings.map((heading) => ({
  level: heading.depth,
  text: heading.text,
  slug: heading.slug,
}));
---

<ContentPage title={article.data.title}>
  <div class="blog-wrapper">
    <div class="blog-main">
      <BackLink href="/blog/">Back to Blog</BackLink>
      <div class="meta">
        <span class="authors">
          {
            article.data.authors.map((author, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/blog/authors/${authorSlug(author)}/`}>{author}</a>
              </>
            ))
          }
        </span>
        <time datetime={article.data.date.toISOString()}>
          {
            article.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })
          }
        </time>
      </div>
      <Content />
    </div>
    <div class="blog-toc">
      <TableOfContents headings={headingsWithSlugs} />
    </div>
  </div>
</ContentPage>

<style>
  .blog-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .blog-main {
    min-width: 0;
  }

  .blog-toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .blog-wrapper {
      grid-template-columns: 1fr 240px;
      gap: var(--space-xl);
    }

    .blog-toc {
      display: block;
      position: sticky;
      top: var(--space-xl);
      height: fit-content;
    }
  }

  .meta {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    margin-block-end: var(--space-md);
  }
</style>
