---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const articles = (await getCollection('articles', (entry) => !entry.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <main>
    <div class="blog-wrap">
      <h1>Blog</h1>
      <ul class="article-list">
        {articles.map((article) => (
          <li>
            <a href={`/blog/${article.id}/`}>
              <h2>{article.data.title}</h2>
              {article.data.description && <p>{article.data.description}</p>}
              <time datetime={article.data.date.toISOString()}>
                {article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>

<style>
.blog-wrap {
  padding: var(--space-3xl);
}

h1 {
  margin-block-end: var(--space-md);
}

.article-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.article-list a {
  text-decoration: none;
  color: inherit;
  display: block;
}

.article-list a:hover h2 {
  color: var(--color-accent);
}

.article-list h2 {
  margin: 0;
}

.article-list p {
  margin: var(--space-xs) 0 0;
}

.article-list time {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}
</style>
