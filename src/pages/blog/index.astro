---
import { getCollection } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';
import { authorSlug } from '../../lib/authors';

const articles = (await getCollection('articles', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<ContentPage title="Blog" aside={false}>
  <ul class="article-list">
    {
      articles.map((article) => (
        <li>
          <h2>
            <a href={`/blog/${article.id}/`}>{article.data.title}</a>
          </h2>
          {article.data.description && <p>{article.data.description}</p>}
          <div class="meta">
            <span class="authors">
              {article.data.authors.map((author, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/blog/authors/${authorSlug(author)}/`}>{author}</a>
                </>
              ))}
            </span>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </div>
        </li>
      ))
    }
  </ul>
</ContentPage>

<style>
  .article-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .article-list h2 {
    margin: 0;
  }

  .article-list p {
    margin: var(--space-xs) 0 0;
  }

  .article-list .meta {
    display: flex;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
</style>
