---
import Layout from '../layouts/Layout.astro';
import EntryCard from '../components/EntryCard.astro';

const articles = [
  {
    href: '#',
    secondaryLabel: 'Ben Callahan',
    primaryLabel: 'The Question Episode 057 Recap',
    date: new Date(Date.UTC(2025, 6, 10)),
  },
  {
    href: '#',
    secondaryLabel: 'Ben Callahan, Brad Frost',
    primaryLabel: 'The Question Episode 056 Recap',
    date: new Date(Date.UTC(2025, 5, 27)),
  },
  {
    href: '#',
    secondaryLabel: 'Ben Callahan',
    primaryLabel: 'Analysis vs Synthesis',
    date: new Date(Date.UTC(2024, 2, 5)),
  },
];
---

<Layout>
  <h1 class="headline">
    Redwoods is a group of <span class="accent">life-long learners</span> committed to supporting each
    other on the journey of design system maturity.
  </h1>

  <Fragment slot="aside">
    <div class="aside-wrap">
      <section class="aside-card">
        <h2>What we've learned</h2>
        <div class="entry-list">
          {articles.map((article) => <EntryCard {...article} />)}
        </div>
      </section>
      <section class="aside-card">
        <h2>Where we'll be</h2>
        <div class="entry-list">
          <EntryCard
            href="#"
            tone="woodland"
            secondaryLabel="Bristol, UK"
            primaryLabel="Converge, 2025"
            date={new Date(Date.UTC(2025, 9, 30))}
            endDate={new Date(Date.UTC(2025, 9, 31))}
          />
        </div>
      </section>
    </div>
  </Fragment>
</Layout>

<style>
  .headline {
    margin-block-start: 0;
    font-size: var(--font-size-hero);
  }

  /* Grows to display size once the main column itself is wide, not the
     viewport — see the container on .main-wrap in Page.astro. */
  @container main (min-width: 640px) {
    .headline {
      font-size: var(--font-size-hero-max);
    }
  }

  .accent {
    color: var(--color-green);
  }

  .aside-wrap {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .aside-card h2 {
    margin: 0 0 var(--space-md);
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
</style>
