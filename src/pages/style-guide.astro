---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Header from '../components/Header.astro';
import trees from '../assets/trees-01.png';

const codeSampleJs = `const site = 'https://joinredwoods.com';
console.log(site);`;

const codeSamplePlain = `src/
  content/
    articles/
      hello-world.mdx
  styles/
    base.css`;

const brand = [
  { name: 'orange', token: '--color-orange' },
  { name: 'woodland', token: '--color-woodland' },
  { name: 'green', token: '--color-green' },
  { name: 'blue', token: '--color-blue' },
  { name: 'cream', token: '--color-cream' },
];

const grayScale = ['00', '25', '50', '75', '100'];

const semanticColors = [
  { name: 'bg', token: '--color-bg' },
  { name: 'surface', token: '--color-surface' },
  { name: 'text', token: '--color-text' },
  { name: 'border', token: '--color-border' },
  { name: 'accent', token: '--color-accent' },
  { name: 'accent-contrast', token: '--color-accent-contrast' },
];

const typeSamples = [
  { tag: 'h1', label: 'Heading 1', token: '--font-size-4xl' },
  { tag: 'h2', label: 'Heading 2', token: '--font-size-3xl' },
  { tag: 'h3', label: 'Heading 3', token: '--font-size-2xl' },
  { tag: 'h4', label: 'Heading 4', token: '--font-size-xl' },
  { tag: 'h5', label: 'Heading 5', token: '--font-size-lg' },
  { tag: 'h6', label: 'Heading 6', token: '--font-size-md' },
] as const;

const spacingSteps = ['3xs', '2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'];
const radiiSteps = ['xs', 'sm', 'md', 'lg', 'xl', 'full'];

const buttonVariants = ['primary', 'secondary', 'ghost', 'danger'] as const;
const buttonSizes = ['sm', 'md', 'lg'] as const;

const sections = [
  { id: 'colors', label: 'Colors' },
  { id: 'typography', label: 'Typography' },
  { id: 'spacing', label: 'Spacing' },
  { id: 'radii', label: 'Radii' },
  { id: 'buttons', label: 'Buttons' },
  { id: 'links', label: 'Links' },
  { id: 'inline', label: 'Inline formatting' },
  { id: 'lists', label: 'Lists' },
  { id: 'blockquotes', label: 'Blockquotes' },
  { id: 'rules', label: 'Horizontal rules' },
  { id: 'tables', label: 'Tables' },
  { id: 'images', label: 'Images' },
  { id: 'code', label: 'Code' },
  { id: 'header', label: 'Header' },
];
---

<Layout>
  <main class="guide">
    <header class="guide__header">
      <p class="guide__eyebrow">Redwoods</p>
      <h1>Style guide</h1>
      <p class="guide__lede">
        A style guide for the tokens, styles, components, and patterns that make up this site. If
        you're making a resuable pattern for the site please add new examples here so contributors
        always have one place to look.
      </p>
      <nav class="guide__nav" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>

    <section id="colors" class="section">
      <div class="section__head">
        <h2>Colors</h2>
        <p>
          Brand and gray scale palette plus semantic aliases. Use the semantic aliases wherever
          possible; reach for the brand and gray scale palette as a last resort.
        </p>
      </div>

      <h3 class="subhead">Brand</h3>
      <div class="swatches">
        {
          brand.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Gray Scale</h3>
      <div class="swatches">
        {
          grayScale.map((step) => (
            <div class="swatch" style={`--swatch: var(--color-gray-${step})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">gray-{step}</span>
                <code class="swatch__token">--color-gray-{step}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Semantic</h3>
      <div class="swatches">
        {
          semanticColors.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="typography" class="section">
      <div class="section__head">
        <h2>Typography</h2>
        <p>
          Stack is <code>var(--font-serif)</code> for headings and <code>var(--font-sans)</code> for body
          copy.
        </p>
        <p>
          Headings balance; paragraphs use <code>text-wrap: pretty</code> and cap at <code
            >--layout-prose-max</code
          >.
        </p>
      </div>

      <div class="type-scale">
        {
          typeSamples.map((t) => (
            <div class="type-row">
              <div class="type-row__sample">
                <t.tag>{t.label}</t.tag>
              </div>
              <code class="type-row__token">{t.token}</code>
            </div>
          ))
        }
        <div class="type-row">
          <div class="type-row__sample">
            <p>
              Body paragraph. The quick brown fox jumps over the lazy dog. Use this for the bulk of
              flowing content — it inherits from <code>body</code> and wraps on <code>pretty</code> for
              pleasant line breaks.
            </p>
          </div>
          <code class="type-row__token">--font-size-base</code>
        </div>
        <div class="type-row">
          <div class="type-row__sample">
            <small>Small caption text.</small>
          </div>
          <code class="type-row__token">--font-size-sm</code>
        </div>
      </div>
    </section>

    <section id="links" class="section">
      <div class="section__head">
        <h2>Links</h2>
        <p>
          Anchor defaults live in <code>base.css</code>. Focus rings come from <code
            >--color-focus</code
          >.
        </p>
      </div>
      <ul class="link-list">
        <li><a href="#links">Default link — hover to see the color shift</a></li>
        <li><a href="https://example.com" rel="external">External link</a></li>
        <li>
          Inline: visit the <a href="#colors">colors section</a> to see tokens in context, or jump to
          <a href="#typography">typography</a>.
        </li>
      </ul>
    </section>

    <section id="inline" class="section">
      <div class="section__head">
        <h2>Inline formatting</h2>
        <p>
          Emphasis primitives that flow inside paragraphs. Inherit color and size from the
          surrounding text.
        </p>
      </div>
      <p>
        A paragraph with <strong>bold text</strong>, <em>italic text</em>, and
        <strong><em>bold italic</em></strong> together. You can also use <code>inline code</code> for
        technical terms like <code>Array.prototype.map()</code>.
      </p>
    </section>

    <section id="lists" class="section">
      <div class="section__head">
        <h2>Lists</h2>
        <p>
          Lists use <code>padding-inline-start: var(--space-lg)</code> from <code>base.css</code>.
          Markers stay inside the content box.
        </p>
      </div>
      <h3 class="subhead">Unordered</h3>
      <ul>
        <li>First item</li>
        <li>Second item</li>
        <li>
          Third item with a nested list
          <ul>
            <li>Nested item A</li>
            <li>Nested item B</li>
          </ul>
        </li>
      </ul>
      <h3 class="subhead">Ordered</h3>
      <ol>
        <li>Step one</li>
        <li>Step two</li>
        <li>
          Step three with a nested list
          <ol>
            <li>Sub-step A</li>
            <li>Sub-step B</li>
          </ol>
        </li>
      </ol>
    </section>

    <section id="blockquotes" class="section">
      <div class="section__head">
        <h2>Blockquotes</h2>
        <p>
          Left border uses <code>--color-accent</code>. Styled in <code>base.css</code>.
        </p>
      </div>
      <blockquote>
        <p>The best time to plant a tree was twenty years ago. The second best time is now.</p>
      </blockquote>
      <h3 class="subhead">Multi-paragraph</h3>
      <blockquote>
        <p>This is the first paragraph inside the quote.</p>
        <p>
          And this is the second paragraph. Blockquotes can contain <strong>bold</strong>, <em
            >italic</em
          >, and other inline formatting.
        </p>
      </blockquote>
    </section>

    <section id="rules" class="section">
      <div class="section__head">
        <h2>Horizontal rules</h2>
        <p>
          Thin divider using <code>--color-border</code>, with <code>--space-lg</code> block margin.
          Styled in <code>base.css</code>.
        </p>
      </div>
      <p>Content above the rule.</p>
      <hr />
      <p>Content below the rule.</p>
    </section>

    <section id="tables" class="section">
      <div class="section__head">
        <h2>Tables</h2>
        <p>
          Full-width with collapsed borders. Rows separated by <code>--color-border</code>. Styled
          in <code>base.css</code>.
        </p>
      </div>
      <table>
        <thead>
          <tr><th>Token</th><th>Value</th><th>Usage</th></tr>
        </thead>
        <tbody>
          <tr><td>--space-sm</td><td>8px</td><td>Tight gaps</td></tr>
          <tr><td>--space-md</td><td>16px</td><td>Default spacing</td></tr>
          <tr><td>--space-lg</td><td>24px</td><td>Section padding</td></tr>
        </tbody>
      </table>
    </section>

    <section id="images" class="section">
      <div class="section__head">
        <h2>Images</h2>
        <p>
          Images are fluid by default — <code>max-width: 100%</code> and
          <code>height: auto</code> via <code>base.css</code>. Use Astro's <code>&lt;Image&gt;</code>
          component for assets in <code>src/assets/</code> so they're optimized.
        </p>
      </div>
      <Image src={trees} alt="Illustrated redwood trees" width={320} />
    </section>

    <section id="code" class="section">
      <div class="section__head">
        <h2>Code</h2>
        <p>
          Inline <code>code</code> gets a subtle background from <code>--color-border</code>. Code
          blocks use the <code>github-light-high-contrast</code> Shiki theme for WCAG AA compliance.
        </p>
      </div>
      <h3 class="subhead">Inline</h3>
      <p>
        Use <code>var(--color-accent)</code> for brand highlights, or run <code>pnpm dev</code> to start
        the server.
      </p>
      <h3 class="subhead">Block (with language)</h3>
      <Code code={codeSampleJs} lang="js" theme="github-light-high-contrast" />

      <h3 class="subhead">Block (plain)</h3>
      <Code code={codeSamplePlain} theme="github-light-high-contrast" />
    </section>

    <section id="spacing" class="section">
      <div class="section__head">
        <h2>Spacing</h2>
        <p>
          T-shirt scale from <code>3xs</code> to <code>4xl</code>. Use for margin, padding, and gap.
          Don't use in places where the values align coincidently.
        </p>
      </div>
      <div class="scale-list">
        {
          spacingSteps.map((step) => (
            <div class="scale-row">
              <span class="scale-row__label">space-{step}</span>
              <div class="scale-row__bar" style={`width: var(--space-${step})`} />
              <code class="scale-row__token">--space-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section id="radii" class="section">
      <div class="section__head">
        <h2>Radii</h2>
        <p>Rounded corners, from crisp to pill.</p>
      </div>
      <div class="radii-grid">
        {
          radiiSteps.map((step) => (
            <div class="radii-sample">
              <div class="radii-sample__tile" style={`border-radius: var(--radius-${step})`} />
              <span class="radii-sample__name">radius-{step}</span>
              <code class="radii-sample__token">--radius-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <!-- <section id="buttons" class="section">
      <div class="section__head">
        <h2>Buttons</h2>
        <p><code>&lt;Button variant size href type disabled /&gt;</code>. When <code>href</code> is set the component renders an <code>&lt;a&gt;</code> styled as a button.</p>
      </div>

      <h3 class="subhead">Variants (size md)</h3>
      <div class="cluster">
        {
          buttonVariants.map((v) => (
            <Button variant={v}>{v.charAt(0).toUpperCase() + v.slice(1)}</Button>
          ))
        }
      </div>

      <h3 class="subhead">Sizes (primary)</h3>
      <div class="cluster cluster--baseline">
        {buttonSizes.map((s) => <Button size={s}>Size {s}</Button>)}
      </div>

      <h3 class="subhead">States</h3>
      <div class="cluster">
        <Button>Default</Button>
        <Button>Focused (tab to reveal)</Button>
        <Button disabled>Disabled</Button>
      </div>

      <h3 class="subhead">Rendered as anchor</h3>
      <div class="cluster">
        <Button variant="secondary" href="#buttons">Anchor button</Button>
      </div>
    </section> -->

    <section id="header" class="section">
      <div class="section__head">
        <h2>Header</h2>
        <p>
          <code>&lt;Header compact /&gt;</code>. The default variant is the home hero with the trees
          artwork; the compact variant is for interior pages.
        </p>
      </div>

      <h3 class="subhead">Default</h3>
      <Header />

      <h3 class="subhead">Compact</h3>
      <Header compact />
    </section>
  </main>
</Layout>

<style>
  .guide {
    max-width: var(--layout-content-max);
    margin-inline: auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .guide__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .guide__eyebrow {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .guide__lede {
    color: var(--color-text);
    max-width: var(--layout-prose-max);
  }

  .guide__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-top: var(--space-md);
  }

  .guide__nav a {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    scroll-margin-block-start: var(--space-xl);
  }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .section__head p {
    color: var(--color-text);
  }

  .subhead {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    margin-block-start: var(--space-md);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-md);
  }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    background: var(--color-gray-100);
  }

  .swatch__color {
    height: 72px;
    border-radius: var(--radius-sm);
    background: var(--swatch);
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .swatch__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .swatch__name {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .swatch__token {
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .type-scale {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .type-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-bottom: 1px dashed var(--color-border);
  }

  .type-row:last-child {
    border-bottom: 0;
  }

  .type-row__sample > * {
    margin: 0;
  }

  .type-row__token {
    font-size: var(--font-size-xs);
    color: var(--color-text);
    white-space: nowrap;
  }

  .scale-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .scale-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: var(--space-md);
  }

  .scale-row__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .scale-row__bar {
    height: 12px;
    background: var(--color-surface);
    border-radius: var(--radius-full);
    min-width: 2px;
  }

  .scale-row__token {
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .radii-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(144px, 1fr));
    gap: var(--space-lg);
  }

  .radii-sample {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
  }

  .radii-sample__tile {
    width: 80px;
    height: 80px;
    background: var(--color-surface);
  }

  .radii-sample__name {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .radii-sample__token {
    font-size: var(--font-size-xs);
    color: var(--color-text);
  }

  .cluster {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .cluster--baseline {
    align-items: baseline;
  }

  .link-list {
    list-style: disc;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  code {
    padding: 0 var(--space-2xs);
    border-radius: var(--radius-xs);
  }
</style>
