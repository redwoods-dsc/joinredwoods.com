---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import ButtonRow from '../components/ButtonRow.astro';
import EntryCard from '../components/EntryCard.astro';
import Figure from '../components/Figure.astro';
import QuestionPromo from '../components/QuestionPromo.astro';
import Hero from '../components/Hero.astro';
import Lede from '../components/Lede.astro';
import Note from '../components/Note.astro';
import Quote from '../components/Quote.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import trees from '../assets/trees-01.png';

const codeSampleJs = `const site = 'https://joinredwoods.com';
console.log(site);`;

const codeSamplePlain = `src/
  content/
    articles/
      hello-world.mdx
  styles/
    base.css`;

const brand = [
  { name: 'orange', token: '--color-orange' },
  { name: 'green', token: '--color-green' },
  { name: 'blue', token: '--color-blue' },
  { name: 'cream', token: '--color-cream' },
];

const grayScale = ['00', '25', '50', '75', '100'];

const alpha = ['56', '72'];

const semanticColors = [
  { name: 'bg', token: '--color-bg' },
  { name: 'surface', token: '--color-surface' },
  { name: 'surface-contrast', token: '--color-surface-contrast' },
  { name: 'text', token: '--color-text' },
  { name: 'border', token: '--color-border' },
  { name: 'accent', token: '--color-accent' },
  { name: 'accent-contrast', token: '--color-accent-contrast' },
];

const typeSamples = [
  { tag: 'h1', label: 'Heading 1', token: '--font-size-4xl' },
  { tag: 'h2', label: 'Heading 2', token: '--font-size-3xl' },
  { tag: 'h3', label: 'Heading 3', token: '--font-size-2xl' },
  { tag: 'h4', label: 'Heading 4', token: '--font-size-xl' },
  { tag: 'h5', label: 'Heading 5', token: '--font-size-lg' },
  { tag: 'h6', label: 'Heading 6', token: '--font-size-md' },
] as const;

const spacingSteps = ['3xs', '2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'];
const radiiSteps = ['xs', 'sm', 'md', 'lg', 'xl', 'full'];

const buttonVariants = ['primary', 'secondary', 'ghost', 'danger'] as const;
const buttonSizes = ['sm', 'md', 'lg'] as const;

const arrowLinkMargins = ['none', 'sm', 'md', 'lg'] as const;
const arrowLinkSizes = ['smaller', 'body', 'larger'] as const;

const calloutTones = ['green', 'blue', 'orange', 'dark', 'white'] as const;

const entryToneSample = new Date(Date.UTC(2025, 6, 10)); // 10 Jul 2025

// Fixed dates on both sides, so these demos render the same state forever and
// the Chromatic snapshot can't drift. Passing a question explicitly also opts
// the card out of browser-side expiry, which is what keeps the open demo open
// even once the real question has closed.
const questionOpenSample = {
  number: 80,
  question: 'How do we visualise design system health?',
  cohosts: ['Robin Di Capua', 'Taylor Cashdan'],
  episodeDate: new Date(Date.UTC(2099, 7, 28)),
  answerBy: new Date(Date.UTC(2099, 7, 27)),
  answerUrl: '#question-promo',
};
const questionClosedSample = {
  ...questionOpenSample,
  episodeDate: new Date(Date.UTC(2020, 7, 28)),
  answerBy: new Date(Date.UTC(2020, 7, 27)),
};

// Document order, not grouped order: this list is both the jump nav and the
// headings the two wide TableOfContents demos are fed, and that component marks
// the section you're reading. Out of order, the marker jumps around the rail.
const sections = [
  { id: 'colors', label: 'Colors' },
  { id: 'typography', label: 'Typography' },
  { id: 'links', label: 'Links' },
  { id: 'inline', label: 'Inline formatting' },
  { id: 'lists', label: 'Lists' },
  { id: 'blockquotes', label: 'Blockquotes' },
  { id: 'rules', label: 'Horizontal rules' },
  { id: 'tables', label: 'Tables' },
  { id: 'images', label: 'Images' },
  { id: 'figure', label: 'Figure' },
  { id: 'code', label: 'Code' },
  { id: 'spacing', label: 'Spacing' },
  { id: 'radii', label: 'Radii' },
  { id: 'buttons', label: 'Buttons' },
  { id: 'button-row', label: 'Button row' },
  { id: 'arrow-link', label: 'Arrow link' },
  { id: 'hero', label: 'Hero' },
  { id: 'lede', label: 'Lede' },
  { id: 'note', label: 'Note' },
  { id: 'callout', label: 'Callout' },
  { id: 'entry-card', label: 'Entry card' },
  { id: 'question-promo', label: 'The Question' },
  { id: 'header', label: 'Header' },
  { id: 'footer', label: 'Footer' },
  { id: 'toc', label: 'Table of contents' },
  { id: 'layout', label: 'Layout' },
];
---

<Layout
  aside={false}
  title="Style Guide"
  description="The live reference for Redwoods design tokens and component primitives."
  noindex
>
  <div class="guide">
    <header class="guide__header">
      <h2>Style guide</h2>
      <p class="guide__subtitle">
        The tokens, styles, components and patterns this site is built from. Adding a reusable
        pattern? Add an example here too, so contributors keep one place to look.
      </p>
      <nav class="guide__nav" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>

    <section id="colors" class="section">
      <div class="section__head">
        <h2>Colors</h2>
        <p>
          The brand and gray scale palettes, plus the semantic aliases. Reach for an alias wherever
          one fits; the raw palette is a last resort.
        </p>
      </div>

      <h3 class="subhead">Brand</h3>
      <div class="swatches">
        {
          brand.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Gray Scale</h3>
      <div class="swatches">
        {
          grayScale.map((step) => (
            <div class="swatch" style={`--swatch: var(--color-gray-${step})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">gray-{step}</span>
                <code class="swatch__token">--color-gray-{step}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Alpha</h3>
      <div class="swatches">
        {
          alpha.map((step) => (
            <div class="swatch" style={`--swatch: var(--color-gray-alpha-${step})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">gray-alpha-{step}</span>
                <code class="swatch__token">--color-gray-alpha-{step}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Semantic</h3>
      <div class="swatches">
        {
          semanticColors.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Selection</h3>
      <p>
        <code>--selection-bg</code> and <code>--selection-fg</code> are what <code>::selection</code
        > paints with — a wash of <code>--color-focus</code> over the page's own text by default. The
        pseudo-element inherits custom properties from the element it originates on, so a block that reverses
        its ground sets the pair once and every selection inside it follows; the callout tones, entry
        cards and the header each do. Select this paragraph and then some copy inside a
        <a href="#callout">callout</a> to see the difference.
      </p>
    </section>

    <section id="typography" class="section">
      <div class="section__head">
        <h2>Typography</h2>
        <p>
          <code>var(--font-serif)</code> for headings, <code>var(--font-sans)</code> for body copy. Headings
          balance; paragraphs use <code>text-wrap: pretty</code> and cap at
          <code>--layout-prose-max</code>.
        </p>
      </div>

      <div class="type-scale">
        <div class="type-row">
          <div class="type-row__sample">
            <p class="type-hero">Hero headline</p>
          </div>
          <code class="type-row__token">--font-size-hero</code>
        </div>
        {
          typeSamples.map((t) => (
            <div class="type-row">
              <div class="type-row__sample">
                <t.tag>{t.label}</t.tag>
              </div>
              <code class="type-row__token">{t.token}</code>
            </div>
          ))
        }
        <div class="type-row">
          <div class="type-row__sample">
            <p>
              Body paragraph. The quick brown fox jumps over the lazy dog. Use this for the bulk of
              flowing content — it inherits from <code>body</code> and wraps on <code>pretty</code> for
              pleasant line breaks.
            </p>
          </div>
          <code class="type-row__token">--font-size-md</code>
        </div>
        <div class="type-row">
          <div class="type-row__sample">
            <small>Small caption text.</small>
          </div>
          <code class="type-row__token">--font-size-sm</code>
        </div>
        <div class="type-row">
          <div class="type-row__sample">
            <p class="type-caption">Caption text — copyright lines, metadata, fine print.</p>
          </div>
          <code class="type-row__token">--font-size-caption</code>
        </div>
      </div>

      <h3 class="subhead">Heading rhythm</h3>
      <p>
        In <code>base.css</code> every heading gets <code>--space-lg</code> above it and
        <code>--space-xs</code> below, with h2 stepped up to <code>--space-xl</code>. The tight
        space below is deliberate — a heading should sit with the content it introduces rather than
        float between two blocks.
      </p>
      <p>
        Content pages open the space above up a step from the base scale, since a lone measure of
        prose can carry it. Set in <code>ContentPage.astro</code>.
      </p>
      <table>
        <thead>
          <tr><th>Space above</th><th>Content page</th><th>Base</th></tr>
        </thead>
        <tbody>
          <tr><td>h2</td><td>--space-2xl (48px)</td><td>--space-xl (32px)</td></tr>
          <tr><td>h3</td><td>--space-xl (32px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>h4</td><td>--space-lg (24px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>h5, h6</td><td>--space-md (16px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>paragraph</td><td>--space-md (16px)</td><td>--space-md (16px)</td></tr>
        </tbody>
      </table>
      <p>
        h5 and h6 land on the same gap as a paragraph, on purpose: at that depth a heading reads as
        a run-in label rather than a section break. A page intro carries
        <code>--space-3xl</code> below it, dropping to <code>--space-xl</code> when it holds a subtitle
        or a byline — either one closes the block visually, so the larger gap stops earning its place.
      </p>
    </section>

    <section id="links" class="section">
      <div class="section__head">
        <h2>Links</h2>
        <p>
          Anchor defaults live in <code>base.css</code>. Focus rings come from <code
            >--color-focus</code
          >.
        </p>
      </div>
      <ul class="link-list">
        <li><a href="#links">Default link — hover to see the color shift</a></li>
        <li><a href="https://example.com" rel="external">External link</a></li>
        <li>
          Inline: visit the <a href="#colors">colors section</a> to see tokens in context, or jump to
          <a href="#typography">typography</a>.
        </li>
      </ul>

      <h3 class="subhead">On accent background</h3>
      <p>
        <code>--color-focus</code> is the same hue as <code>--color-accent</code>, so the default
        ring disappears on an accent-colored surface. Override <code>outline-color</code> to <code
          >--color-accent-contrast</code
        > wherever a link sits on <code>--color-accent</code> (see the header nav).
      </p>
      <div class="link-on-accent">
        <a href="#links" class="link-on-accent__link">Link on accent — tab to reveal the ring</a>
      </div>
    </section>

    <section id="inline" class="section">
      <div class="section__head">
        <h2>Inline formatting</h2>
        <p>
          Emphasis primitives that flow inside paragraphs. Inherit color and size from the
          surrounding text.
        </p>
      </div>
      <p>
        A paragraph with <strong>bold text</strong>, <em>italic text</em>, and
        <strong><em>bold italic</em></strong> together. You can also use <code>inline code</code> for
        technical terms like <code>Array.prototype.map()</code>.
      </p>
    </section>

    <section id="lists" class="section">
      <div class="section__head">
        <h2>Lists</h2>
        <p>
          Lists use <code>padding-inline-start: var(--space-lg)</code> from <code>base.css</code>.
          Markers stay inside the content box.
        </p>
      </div>
      <h3 class="subhead">Unordered</h3>
      <ul>
        <li>First item</li>
        <li>Second item</li>
        <li>
          Third item with a nested list
          <ul>
            <li>Nested item A</li>
            <li>Nested item B</li>
          </ul>
        </li>
      </ul>
      <h3 class="subhead">Ordered</h3>
      <ol>
        <li>Step one</li>
        <li>Step two</li>
        <li>
          Step three with a nested list
          <ol>
            <li>Sub-step A</li>
            <li>Sub-step B</li>
          </ol>
        </li>
      </ol>
    </section>

    <section id="blockquotes" class="section">
      <div class="section__head">
        <h2>Blockquotes</h2>
        <p>
          Left border uses <code>--color-accent</code>. Styled in <code>base.css</code>, so a
          Markdown <code>&gt;</code> quote and a <code>&lt;Quote&gt;</code> get the same treatment.
        </p>
        <p>
          The quote sets in <code>--font-serif</code> at <code>--font-size-lg</code>, a step up from
          body copy so it reads as a change of voice rather than indented body text. An attribution
          line stays on the sans body scale — it's a label about the quote, not part of it.
        </p>
      </div>
      <blockquote>
        <p>The best time to plant a tree was twenty years ago. The second best time is now.</p>
      </blockquote>
      <h3 class="subhead">Multi-paragraph</h3>
      <blockquote>
        <p>This is the first paragraph inside the quote.</p>
        <p>
          And this is the second paragraph. Blockquotes can contain <strong>bold</strong>, <em
            >italic</em
          >, and other inline formatting.
        </p>
      </blockquote>

      <h3 class="subhead">Attributed</h3>
      <p>
        <code>&lt;Quote cite role marker&gt;</code>. A blockquote with an attribution line, so pull
        quotes can be written in Markdown without hand-rolling the
        <code>&lt;footer&gt;</code>/<code>&lt;cite&gt;</code> markup each time. <code>role</code> is optional,
        and <code>marker</code> overrides the leading <code>~</code>.
      </p>
      <Quote cite="ToniAnn" role="Redwoods member">
        “Redwoods is one of the only communities where I feel like I can not only grow in my own DS
        practice by learning from others, but also have a hand in shaping the world of design
        systems at large.”
      </Quote>
      <Quote cite="John Muir" marker="―">
        “When one tugs at a single thing in nature, he finds it attached to the rest of the world.”
      </Quote>
    </section>

    <section id="rules" class="section">
      <div class="section__head">
        <h2>Horizontal rules</h2>
        <p>
          Thin divider using <code>--color-border</code>, with <code>--space-lg</code> block margin. Styled
          in <code>base.css</code>.
        </p>
      </div>
      <p>Content above the rule.</p>
      <hr />
      <p>Content below the rule.</p>
    </section>

    <section id="tables" class="section">
      <div class="section__head">
        <h2>Tables</h2>
        <p>
          Full-width with collapsed borders, rows separated by <code>--color-border</code>. Styled
          in
          <code>base.css</code>. A table can't shrink past the sum of its columns' min-content, so
          it's its own horizontal scroll container — on a narrow screen it scrolls rather than being
          clipped by the card around it.
        </p>
      </div>
      <table>
        <thead>
          <tr><th>Token</th><th>Value</th><th>Usage</th></tr>
        </thead>
        <tbody>
          <tr><td>--space-xs</td><td>8px</td><td>Tight gaps</td></tr>
          <tr><td>--space-md</td><td>16px</td><td>Default spacing</td></tr>
          <tr><td>--space-lg</td><td>24px</td><td>Section padding</td></tr>
        </tbody>
      </table>
    </section>

    <section id="images" class="section">
      <div class="section__head">
        <h2>Images</h2>
        <p>
          Images are fluid by default — <code>max-width: 100%</code> and
          <code>height: auto</code> via <code>base.css</code>. Use Astro's <code>&lt;Image&gt;</code
          >
          component for assets in <code>src/assets/</code> so they're optimized.
        </p>
      </div>
      <Image src={trees} alt="Illustrated redwood trees" width={320} />
    </section>

    <section id="figure" class="section">
      <div class="section__head">
        <h2>Figure</h2>
        <p>
          <code>&lt;Figure src alt caption /&gt;</code>. An article image with a caption under it.
          Everything after <code>alt</code> and <code>caption</code> passes through to Astro's
          <code>&lt;Image&gt;</code>, so <code>width</code>, <code>quality</code> and the rest are available
          — the reason to reach for this over markdown's <code>![alt](src)</code>, which takes no
          options at all.
        </p>
        <p>
          Leave <code>caption</code> off and the <code>alt</code> is shown as the caption, with the image's
          own alt emptied so a screen reader reads the sentence once rather than twice. Pass both when
          they should say different things and both are kept. Markdown images get the same treatment automatically;
          see <code>rehypeFigureCaptions</code> in
          <code>astro.config.mjs</code>.
        </p>
      </div>

      <h3 class="subhead">Alt as caption</h3>
      <Figure src={trees} alt="Illustrated redwood trees" width={480} />

      <h3 class="subhead">Without the border</h3>
      <Figure
        src={trees}
        alt="Illustrated redwood trees, no rule around them"
        width={480}
        border={false}
      />

      <h3 class="subhead">Separate alt and caption</h3>
      <Figure
        src={trees}
        alt="Two illustrated redwood trees against a cream ground"
        caption="Coastal redwoods, drawn for the site header."
        width={480}
      />
    </section>

    <section id="code" class="section">
      <div class="section__head">
        <h2>Code</h2>
        <p>
          Inline <code>code</code> gets a subtle background from <code>--color-border</code>. For
          code blocks, use Astro's <code>&lt;Code&gt;</code> component with the
          <code>github-light-high-contrast</code> Shiki theme for WCAG AA compliance.
        </p>
      </div>
      <h3 class="subhead">Inline</h3>
      <p>
        Use <code>var(--color-accent)</code> for brand highlights, or run <code>pnpm dev</code> to start
        the server.
      </p>
      <h3 class="subhead">Block (with language)</h3>
      <Code code={codeSampleJs} lang="js" theme="github-light-high-contrast" />

      <h3 class="subhead">Block (plain)</h3>
      <Code code={codeSamplePlain} theme="github-light-high-contrast" />
    </section>

    <section id="spacing" class="section">
      <div class="section__head">
        <h2>Spacing</h2>
        <p>
          T-shirt scale from <code>3xs</code> to <code>4xl</code>, for margin, padding and gap.
          Don't reach for a step just because its value happens to match what you want.
        </p>
      </div>
      <div class="scale-list">
        {
          spacingSteps.map((step) => (
            <div class="scale-row">
              <span class="scale-row__label">space-{step}</span>
              <div class="scale-row__bar" style={`width: var(--space-${step})`} />
              <code class="scale-row__token">--space-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section id="radii" class="section">
      <div class="section__head">
        <h2>Radii</h2>
        <p>Rounded corners, from crisp to pill.</p>
      </div>
      <div class="radii-grid">
        {
          radiiSteps.map((step) => (
            <div class="radii-sample">
              <div class="radii-sample__tile" style={`border-radius: var(--radius-${step})`} />
              <span class="radii-sample__name">radius-{step}</span>
              <code class="radii-sample__token">--radius-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section id="buttons" class="section">
      <div class="section__head">
        <h2>Buttons</h2>
        <p>
          <code>&lt;Button variant size href type disabled /&gt;</code>. When <code>href</code> is set
          the component renders an <code>&lt;a&gt;</code> styled as a button.
        </p>
      </div>

      <h3 class="subhead">Variants (size md)</h3>
      <div class="cluster">
        {
          buttonVariants.map((v) => (
            <Button variant={v}>{v.charAt(0).toUpperCase() + v.slice(1)}</Button>
          ))
        }
      </div>

      <h3 class="subhead">Sizes (primary)</h3>
      <div class="cluster cluster--baseline">
        {buttonSizes.map((s) => <Button size={s}>Size {s}</Button>)}
      </div>

      <h3 class="subhead">States</h3>
      <div class="cluster">
        <Button>Default</Button>
        <Button>Focused (tab to reveal)</Button>
        <Button disabled>Disabled</Button>
      </div>

      <h3 class="subhead">Rendered as anchor</h3>
      <div class="cluster">
        <Button variant="secondary" href="#buttons">Anchor button</Button>
      </div>
    </section>

    <section id="button-row" class="section">
      <div class="section__head">
        <h2>Button row</h2>
        <p>
          <code>&lt;ButtonRow&gt;</code>. Lays a group of buttons out in a wrapping row with
          <code>--space-sm</code> between them. <code>base.css</code> spaces prose through adjacency (<code
            >p + p</code
          >, <code>ul + p</code>), which a wrapper element breaks, so the row carries its own <code
            >--space-md</code
          > block margin — that collapses against its neighbours to the same gaps the adjacency chain
          produced.
        </p>
      </div>

      <ButtonRow>
        <Button href="#button-row" size="sm">Join Redwoods</Button>
        <Button href="#button-row" variant="secondary" size="sm">Read our values ↓</Button>
      </ButtonRow>
    </section>

    <section id="arrow-link" class="section">
      <div class="section__head">
        <h2>Arrow link</h2>
        <p>
          <code>&lt;ArrowLink href direction margin /&gt;</code>. A small text link carrying a
          directional arrow — for stepping back out of a page, or on to a fuller list. Colour,
          underline and hover all come from <code>base.css</code>, so it reads as a link everywhere
          a link reads as one.
        </p>
        <p>
          The arrow is <code>aria-hidden</code>, so the accessible name is the text alone.
          <code>margin</code> takes a size and the component decides the side from
          <code>direction</code>: a left arrow precedes what it points at and takes its space below,
          a right arrow follows and takes its space above.
        </p>
      </div>

      <h3 class="subhead">Direction</h3>
      <div class="stack">
        <ArrowLink href="#arrow-link">Back to Field Notes</ArrowLink>
        <ArrowLink href="#arrow-link" direction="right">Read all Field Notes</ArrowLink>
      </div>

      <h3 class="subhead">Size</h3>
      <div class="stack">
        {
          arrowLinkSizes.map((z) => (
            <ArrowLink href="#arrow-link" direction="right" size={z} margin="sm">
              size: {z}
            </ArrowLink>
          ))
        }
      </div>

      <h3 class="subhead">Margin</h3>
      <div class="stack">
        {
          arrowLinkMargins.map((m) => (
            <ArrowLink href="#arrow-link" direction="right" margin={m}>
              margin: {m}
            </ArrowLink>
          ))
        }
      </div>
    </section>

    <section id="hero" class="section">
      <div class="section__head">
        <h2>Hero</h2>
        <p>
          <code>&lt;Hero&gt;</code>. The opening display headline for a page. Renders an
          <code>&lt;h2&gt;</code> at <code>--font-size-hero</code> from 600px up, a step clear of
          <code>--font-size-3xl</code> so a page's opening statement never matches a section heading,
          dropping to <code>--font-size-2xl</code> below that — at 40px a full hero sentence sets as nine
          lines on a phone. The step is a viewport media query rather than a container query: the main
          column isn't monotonic, so sizing on the column fired the step three times across the range.
          Wrap words in <code>&lt;span class="accent"&gt;</code> to pick up
          <code>--color-green</code>.
        </p>
      </div>

      <Hero>
        Redwoods is a group of <span class="accent">life-long learners</span> committed to supporting
        each other.
      </Hero>
    </section>

    <section id="lede" class="section">
      <div class="section__head">
        <h2>Lede</h2>
        <p>
          <code>&lt;Lede&gt;</code>. Wraps the opening block of a page — a headline, the copy under
          it, and whatever closes it out. This block runs at display size and wants a looser scale
          than the base prose rhythm, since 8px under a 48px headline reads as a collision. Children
          step apart by <code>--space-lg</code>, and a closing <code>blockquote</code> gets
          <code>--space-xl</code> so it reads as the end of the block rather than another beat.
        </p>
        <p>
          It owns the gap below it: <code>display: flow-root</code> traps the last child's trailing margin
          inside the block, and the block-start margin of whatever follows is zeroed, so the space under
          a lede is one number at every width rather than a collapsed pair.
          <code>src/pages/index.mdx</code> is the canonical use.
        </p>
      </div>

      <div class="lede-demo">
        <Lede>
          <h3 class="lede-demo__hero">An opening block at display size</h3>
          <p>
            The copy under the headline steps away from it by <code>--space-lg</code> rather than the
            paragraph gap it would get from the base scale.
          </p>
        </Lede>
        <h4>Our Values</h4>
        <p>
          Body copy picks up here. The gap above this heading is the lede's own block-end margin —
          the heading's <code>margin-block-start</code> is zeroed so the two don't stack.
        </p>
      </div>
    </section>

    <section id="note" class="section">
      <div class="section__head">
        <h2>Note</h2>
        <p>
          <code>&lt;Note&gt;</code>. A caveat or aside closing a page's intro — a step larger than
          body copy and italic, set apart from the subtitle above it. The italic comes from CSS
          rather than an <code>&lt;em&gt;</code>: this is an aside set apart by eye, not a phrase
          the sentence stresses, and nothing a screen reader should announce differently.
        </p>
        <p>
          <code>ContentPage</code> takes a <code>note</code> string in frontmatter and renders this same
          component, so plain sentences never touch the body. Reach for the component directly when the
          sentence interpolates a value — frontmatter is YAML and would flatten
          <code>{'{MONTHLY_PRICE}'}</code> into a hard-coded number. <code>src/pages/join.mdx</code> is
          the canonical use.
        </p>
      </div>

      <Note>
        Anything drawn from inside Redwoods is anonymized first, out of respect for the trust that
        makes hard conversations possible.
      </Note>
    </section>

    <section id="callout" class="section">
      <div class="section__head">
        <h2>Callout</h2>
        <p>
          <code>&lt;Callout tone /&gt;</code>. Sets a run of body content on its own ground, filling
          the content card edge to edge. Wrap it around whole sections in <code>.mdx</code> — headings,
          prose, quotes and buttons all come along.
        </p>
        <p>
          Only the colour reaches the card's edges; the box stays on the column so prose keeps its
          measure. The ground rides on a pseudo-element that overruns to the right until
          <code>.shell__main</code>'s <code>overflow: clip</code> trims it.
        </p>
        <p>
          The four coloured tones reverse what sits inside them: prose and headings inherit the
          light foreground, a quote's rule takes it instead of the accent, the button pair inverts,
          and the focus ring switches off <code>--color-focus</code> — orange on the orange tone is 1.00:1,
          an indicator nobody can see. Text selection swaps the tone's own pair too, since the page's
          orange wash disappears on the orange tone and drops dark text onto the dark one.
          <code>white</code> reverses nothing, since the base styles are already right.
        </p>
      </div>

      <div class="callout-tones">
        {
          calloutTones.map((t) => (
            <Callout tone={t}>
              <h3>tone: {t}</h3>
              <p>
                Body copy on the {t} ground, with <a href="#callout">a link</a> to show how it
                reads.
              </p>
              <ButtonRow>
                <Button href="#callout" size="sm">
                  Primary
                </Button>
                <Button href="#callout" variant="secondary" size="sm">
                  Secondary
                </Button>
              </ButtonRow>
            </Callout>
          ))
        }
      </div>

      <h3 class="subhead">Stacked</h3>
      <p>
        Two callouts in a row bump up against each other, so the seam falls where the tones meet
        rather than where the content does. Each keeps its own padding. Both margins have to be
        zeroed: they collapse to the larger of the pair, so dropping one alone leaves the other
        standing and looks like the rule never matched.
      </p>

      <div class="callout-stack">
        <Callout tone="white">
          <p>The first of a stacked pair. Its block-end margin is zeroed.</p>
        </Callout>
        <Callout tone="blue">
          <p>The second picks up flush against it, with no page ground showing through.</p>
        </Callout>
      </div>
    </section>

    <section id="entry-card" class="section">
      <div class="section__head">
        <h2>Entry card</h2>
        <p>
          <code>&lt;EntryCard href primaryLabel secondaryLabel date endDate tone /&gt;</code>. A
          card for linking to Field Notes articles and events. The whole card is a single anchor: a
          date block on the left (its shade calculated from the tone) and a secondary label above a
          bold primary label on the right. Pass a <code>date</code> alone for a single day, or add
          <code>endDate</code> for a range.
        </p>
      </div>

      <h3 class="subhead">Dates</h3>
      <div class="entry-card-demo">
        <EntryCard
          href="#entry-card"
          secondaryLabel="Ben Callahan"
          primaryLabel="The Question Episode 057 Recap"
          date={new Date(Date.UTC(2025, 6, 10))}
        />
        <EntryCard
          href="#entry-card"
          secondaryLabel="Bristol, UK"
          primaryLabel="Converge, 2025"
          date={new Date(Date.UTC(2025, 9, 30))}
          endDate={new Date(Date.UTC(2025, 9, 31))}
        />
        <EntryCard
          href="#entry-card"
          secondaryLabel="London, UK"
          primaryLabel="Cross-month conference"
          date={new Date(Date.UTC(2025, 9, 30))}
          endDate={new Date(Date.UTC(2025, 10, 2))}
        />
      </div>

      <h3 class="subhead">Tones</h3>
      <p>
        The choice is editorial, not decorative: <code>green</code> is for articles,
        <code>blue</code> is for news and events. An article carries its own in frontmatter —
        <code>tone: blue</code> — which the collection schema validates before
        <code>Sidebar.astro</code> hands it to the card. Leave it out and the entry is
        <code>green</code>, so only the exceptions need saying. Outside the collection, pass the
        prop directly.
      </p>
      <div class="entry-card-demo">
        <EntryCard
          href="#entry-card"
          tone="green"
          secondaryLabel="tone: green"
          primaryLabel="The Question Episode 056 Recap"
          date={entryToneSample}
        />
        <EntryCard
          href="#entry-card"
          tone="blue"
          secondaryLabel="tone: blue"
          primaryLabel="Converge, 2025"
          date={entryToneSample}
        />
        <EntryCard
          href="#entry-card"
          tone="orange"
          secondaryLabel="tone: orange"
          primaryLabel="Redwoods in the UK, Fall 2026"
          date={entryToneSample}
        />
      </div>
    </section>

    <section id="question-promo" class="section">
      <div class="section__head">
        <h2>The Question</h2>
        <p>
          <code>&lt;QuestionPromo question /&gt;</code>. The sidebar card for The Question, the
          fortnightly community survey and live discussion Ben runs alongside Redwoods. It has two
          states, chosen by one field: while the survey's <code>answerBy</code> deadline is in the future
          it promotes the open question, and afterwards it falls back to the mailing list. The heading
          says which, and the artwork links to past episodes in both states.
        </p>
        <p>
          It reads <code>src/data/the-question.ts</code> by default — the only file that changes when
          a new question goes live, with no step needed to take one down. Since nothing rebuilds the site
          the moment a survey closes, the deadline is re-checked by an inline script in the document head,
          which can only ever move the card from open to closed; running it there rather than beside the
          markup is what stops a closed question flashing on screen. Pass
          <code>question</code> explicitly, as the demos below do, to pin a fixed state instead.
        </p>
      </div>

      <h3 class="subhead">Question open</h3>
      <div class="question-promo-demo"><QuestionPromo question={questionOpenSample} /></div>

      <h3 class="subhead">Question closed</h3>
      <div class="question-promo-demo"><QuestionPromo question={questionClosedSample} /></div>
    </section>

    <section id="header" class="section">
      <div class="section__head">
        <h2>Header</h2>
        <p>
          <code>&lt;Header /&gt;</code>. The site logo, nav and tagline. Mounted once by the layout
          shell, so pages never import it themselves. It takes two shapes: a full-height rail at
          850&ndash;1000px and above 1300px, and a full-width card everywhere else — see Layout for
          what each breakpoint does.
        </p>
        <p>
          The trees are a background image, anchored to the bottom of the card on tall viewports (<code
            >min-height: 1024px</code
          >). The 1000&ndash;1300px band restates its position so that flip can't swap the canopy
          for the trunks.
        </p>
      </div>

      <div class="header-demo"><Header /></div>
    </section>

    <section id="footer" class="section">
      <div class="section__head">
        <h2>Footer</h2>
        <p>
          <code>&lt;Footer /&gt;</code>. A single site footer carrying the maintainer and community
          attribution. Like the header, it's mounted once by the layout shell and identical on every
          page. In the shell it renders on the cream card surface — a free-standing card spanning
          the columns from 1000px up, flush at the bottom of the joined column at 850&ndash;1000px,
          and flush at the bottom of the single stacked card below that.
        </p>
      </div>

      <div class="footer-demo"><Footer /></div>
    </section>

    <section id="toc" class="section">
      <div class="section__head">
        <h2>Table of contents</h2>
        <p>
          <code>&lt;TableOfContents headings minDepth maxDepth /&gt;</code>. A rail of page headings
          for long-form articles, fed by Astro's <code>headings</code> from <code>render()</code>.
          Nesting is carried by indentation against a single hairline, and the section you're
          currently reading is marked by an accent segment of that rail. Defaults to h2 through h4.
        </p>
        <p>
          Where the <code>main</code> column is at least 960px wide it renders as the sticky rail below;
          narrower than that it collapses to a closed disclosure, so the list stays reachable on a phone
          without pushing the article down. The active marker is progressive enhancement — an <code
            >IntersectionObserver</code
          > sets <code>aria-current</code>, and with scripting off every link still works.
        </p>
      </div>

      <h3 class="subhead">Wide column</h3>
      <p>
        Fed with this page's own sections, so the marker tracks as you scroll. On an article this
        column is sticky and sits in the gutter beside the prose.
      </p>
      <TableOfContents headings={sections.map((s) => ({ depth: 2, slug: s.id, text: s.label }))} />

      <h3 class="subhead">Narrow column</h3>
      <p>
        The same component in a column too narrow for a rail, which is what a phone gets. It becomes
        a closed disclosure so the list stays reachable without pushing the article down, and it
        sits in flow under the title and byline rather than beside them. Native
        <code>&lt;details&gt;</code> — no JavaScript involved.
      </p>
      <div class="toc-narrow-demo">
        <TableOfContents
          headings={sections.map((s) => ({ depth: 2, slug: s.id, text: s.label }))}
        />
      </div>

      <h3 class="subhead">Nesting</h3>
      <p>Each level indents against the shared rail rather than starting a new one:</p>
      <TableOfContents
        headings={[
          { depth: 2, text: 'Getting started', slug: 'getting-started' },
          { depth: 3, text: 'Prerequisites', slug: 'prerequisites' },
          { depth: 3, text: 'Installation', slug: 'installation' },
          { depth: 2, text: 'Usage', slug: 'usage' },
          { depth: 3, text: 'Basic example', slug: 'basic-example' },
          { depth: 4, text: 'With options', slug: 'with-options' },
          { depth: 2, text: 'API reference', slug: 'api-reference' },
          { depth: 3, text: 'Props', slug: 'props' },
        ]}
      />

      <h3 class="subhead">Depth limit</h3>
      <p>
        The same headings at <code>maxDepth={3}</code> — the h4 drops out rather than being flattened
        into its parent:
      </p>
      <TableOfContents
        maxDepth={3}
        headings={[
          { depth: 2, text: 'Getting started', slug: 'getting-started' },
          { depth: 3, text: 'Prerequisites', slug: 'prerequisites' },
          { depth: 3, text: 'Installation', slug: 'installation' },
          { depth: 2, text: 'Usage', slug: 'usage' },
          { depth: 3, text: 'Basic example', slug: 'basic-example' },
          { depth: 4, text: 'With options', slug: 'with-options' },
          { depth: 2, text: 'API reference', slug: 'api-reference' },
          { depth: 3, text: 'Props', slug: 'props' },
        ]}
      />

      <h3 class="subhead">Empty state</h3>
      <p>
        An article with no headings in range renders nothing at all — no empty landmark is left in
        the accessibility tree:
      </p>
      <TableOfContents headings={[]} />
    </section>

    <section id="layout" class="section">
      <div class="section__head">
        <h2>Layout</h2>
        <p>
          Every page uses one responsive shell of four regions — <code>header</code>,
          <code>main</code>, <code>aside</code> and <code>footer</code> — owned by
          <code>Page.astro</code>. Pages provide <code>main</code> content through the default slot; the
          other three are global and identical everywhere, the aside being
          <code>Sidebar.astro</code>. A page wanting the full width opts out with
          <code>&lt;Layout aside=&#123;false&#125;&gt;</code>, which drops the region from the grid
          rather than leaving an empty card — this page is the only one that does.
        </p>
        <p>
          The <code>.shell__*</code> wrappers own the card surface — grid placement, the
          <code>border-radius</code>, the cream fill and clipping — since only the shell knows where
          each card sits. Content styling lives on the inner elements (<code>.main-wrap</code>,
          <code>.footer</code>, <code>.sidebar</code>), each padding with <code>--space-lg</code>,
          the same token as the shell gutter and column gap, so the inset inside a card matches the
          space between cards.
        </p>
        <p>
          <code>.header</code> and <code>.sidebar</code> are the exceptions, and for one reason: a card
          that holds its own position has to be the painted box, or its background scrolls out from under
          its contents.
        </p>
      </div>

      <h3 class="subhead">Breakpoints</h3>
      <p>
        Driven by three breakpoints. These are raw <code>px</code> values rather than tokens because CSS
        custom properties cannot be used inside <code>@media</code> conditions. The middle state is bounded
        at both ends (<code>1299.98px</code>, so no width falls between two blocks), which is why
        the rail states either side of it need no unwinding.
      </p>
      <ul>
        <li>
          <strong>&lt; 850px</strong> — single column: header, main, aside and footer stacked as four
          free-standing rounded cards, a <code>--space-lg</code> gap apart. This is the base state, and
          the one the others are written as departures from: the gap, the fill and the full
          <code>border-radius</code> all sit outside a media query.
        </li>
        <li>
          <strong>850–1000px</strong> — the header becomes the rail: a fixed-width (<code
            >--layout-rail</code
          >), full-viewport-height card pinned with
          <code>position: fixed</code>, while the right column (main + aside + footer) scrolls past
          underneath as one joined card. The only state that joins them, so it's also the only one
          to close the row gap and square off the seams between the three.
        </li>
        <li>
          <strong>1000–1300px</strong> — the rail lies down. The header goes back to the full-width card
          it is below 850px, now spanning the top of the grid, capped at
          <code>--layout-header-min</code> and in normal flow so it scrolls with the page, and main and
          aside sit beside it as two columns with the footer spanning both. All four stand free again.
          The aside is the reason: in the joined column it takes the full width beside the rail, which
          by 1300px is 878px — far wider than the sidebar's cards are drawn for.
        </li>
        <li>
          <strong>&gt; 1300px</strong> — the rail returns, and the aside keeps its own column (<code
            >--layout-aside</code
          >) with the footer spanning main and aside beneath them. The shell grows fluidly to <code
            >--layout-shell-max</code
          >, centered beyond that.
        </li>
      </ul>
      <p>
        In both rail states the shell carries a <code>min-height</code> of
        <code>--layout-rail-height</code>, the height the rail itself stands. The rail is fixed and
        viewport-tall whether the page fills it or not, so without this a short page leaves the page
        showing through beside it. The slack goes to the row above the footer, so the footer lands
        on the rail's bottom edge rather than growing into a tall empty card.
      </p>
      <p>
        1300px is a deliberate trade, worth knowing before anyone <q>fixes</q> it. Bringing the rail back
        costs main its width plus a gap, dropping it from 779px to 407px, and main only clears
        <code>--layout-prose-max</code> again from about 1645px up. Three columns on a 1440px laptop is
        the shape this layout is for, and a narrow main column is the price. The aside doesn't move:
        <code>--layout-aside</code> is floored at 400px, which is above the percentage either side of
        the switch.
      </p>
    </section>
  </div>
</Layout>

