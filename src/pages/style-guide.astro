---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ButtonRow from '../components/ButtonRow.astro';
import EntryCard from '../components/EntryCard.astro';
import QuestionPromo from '../components/QuestionPromo.astro';
import Hero from '../components/Hero.astro';
import Lede from '../components/Lede.astro';
import Quote from '../components/Quote.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import trees from '../assets/trees-01.png';

const codeSampleJs = `const site = 'https://joinredwoods.com';
console.log(site);`;

const codeSamplePlain = `src/
  content/
    articles/
      hello-world.mdx
  styles/
    base.css`;

const brand = [
  { name: 'orange', token: '--color-orange' },
  { name: 'woodland', token: '--color-woodland' },
  { name: 'green', token: '--color-green' },
  { name: 'blue', token: '--color-blue' },
  { name: 'cream', token: '--color-cream' },
];

const grayScale = ['00', '25', '50', '75', '100'];

const semanticColors = [
  { name: 'bg', token: '--color-bg' },
  { name: 'surface', token: '--color-surface' },
  { name: 'surface-contrast', token: '--color-surface-contrast' },
  { name: 'text', token: '--color-text' },
  { name: 'border', token: '--color-border' },
  { name: 'accent', token: '--color-accent' },
  { name: 'accent-contrast', token: '--color-accent-contrast' },
];

const typeSamples = [
  { tag: 'h1', label: 'Heading 1', token: '--font-size-4xl' },
  { tag: 'h2', label: 'Heading 2', token: '--font-size-3xl' },
  { tag: 'h3', label: 'Heading 3', token: '--font-size-2xl' },
  { tag: 'h4', label: 'Heading 4', token: '--font-size-xl' },
  { tag: 'h5', label: 'Heading 5', token: '--font-size-lg' },
  { tag: 'h6', label: 'Heading 6', token: '--font-size-md' },
] as const;

const spacingSteps = ['3xs', '2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'];
const radiiSteps = ['xs', 'sm', 'md', 'lg', 'xl', 'full'];

const buttonVariants = ['primary', 'secondary', 'ghost', 'danger'] as const;
const buttonSizes = ['sm', 'md', 'lg'] as const;

const entryToneSample = new Date(Date.UTC(2025, 6, 10)); // 10 Jul 2025

// Fixed dates on both sides, so these demos render the same state forever and
// the Chromatic snapshot can't drift. Passing a question explicitly also opts
// the card out of browser-side expiry, which is what keeps the open demo open
// even once the real question has closed.
const questionOpenSample = {
  number: 80,
  question: 'How do we visualise design system health?',
  cohosts: ['Robin Di Capua', 'Taylor Cashdan'],
  episodeDate: new Date(Date.UTC(2099, 7, 28)),
  answerBy: new Date(Date.UTC(2099, 7, 27)),
  answerUrl: '#question-promo',
};
const questionClosedSample = {
  ...questionOpenSample,
  episodeDate: new Date(Date.UTC(2020, 7, 28)),
  answerBy: new Date(Date.UTC(2020, 7, 27)),
};

const sections = [
  { id: 'colors', label: 'Colors' },
  { id: 'typography', label: 'Typography' },
  { id: 'spacing', label: 'Spacing' },
  { id: 'radii', label: 'Radii' },
  { id: 'buttons', label: 'Buttons' },
  { id: 'button-row', label: 'Button row' },
  { id: 'hero', label: 'Hero' },
  { id: 'lede', label: 'Lede' },
  { id: 'entry-card', label: 'Entry card' },
  { id: 'question-promo', label: 'The Question' },
  { id: 'links', label: 'Links' },
  { id: 'inline', label: 'Inline formatting' },
  { id: 'lists', label: 'Lists' },
  { id: 'blockquotes', label: 'Blockquotes' },
  { id: 'rules', label: 'Horizontal rules' },
  { id: 'tables', label: 'Tables' },
  { id: 'images', label: 'Images' },
  { id: 'code', label: 'Code' },
  { id: 'header', label: 'Header' },
  { id: 'footer', label: 'Footer' },
  { id: 'toc', label: 'Table of contents' },
  { id: 'layout', label: 'Layout' },
];
---

<Layout
  aside={false}
  title="Style Guide"
  description="The live reference for Redwoods design tokens and component primitives."
  noindex
>
  <div class="guide">
    <header class="guide__header">
      <p class="guide__eyebrow">Redwoods</p>
      <h2>Style guide</h2>
      <p class="guide__lede">
        A style guide for the tokens, styles, components, and patterns that make up this site. If
        you're making a resuable pattern for the site please add new examples here so contributors
        always have one place to look.
      </p>
      <nav class="guide__nav" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
    </header>

    <section id="colors" class="section">
      <div class="section__head">
        <h2>Colors</h2>
        <p>
          Brand and gray scale palette plus semantic aliases. Use the semantic aliases wherever
          possible; reach for the brand and gray scale palette as a last resort.
        </p>
      </div>

      <h3 class="subhead">Brand</h3>
      <div class="swatches">
        {
          brand.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Gray Scale</h3>
      <div class="swatches">
        {
          grayScale.map((step) => (
            <div class="swatch" style={`--swatch: var(--color-gray-${step})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">gray-{step}</span>
                <code class="swatch__token">--color-gray-{step}</code>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="subhead">Semantic</h3>
      <div class="swatches">
        {
          semanticColors.map((c) => (
            <div class="swatch" style={`--swatch: var(${c.token})`}>
              <div class="swatch__color" />
              <div class="swatch__meta">
                <span class="swatch__name">{c.name}</span>
                <code class="swatch__token">{c.token}</code>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="typography" class="section">
      <div class="section__head">
        <h2>Typography</h2>
        <p>
          Stack is <code>var(--font-serif)</code> for headings and <code>var(--font-sans)</code> for body
          copy.
        </p>
        <p>
          Headings balance; paragraphs use <code>text-wrap: pretty</code> and cap at <code
            >--layout-prose-max</code
          >.
        </p>
      </div>

      <div class="type-scale">
        <div class="type-row">
          <div class="type-row__sample">
            <p class="type-hero">Hero headline</p>
          </div>
          <code class="type-row__token">--font-size-hero</code>
        </div>
        {
          typeSamples.map((t) => (
            <div class="type-row">
              <div class="type-row__sample">
                <t.tag>{t.label}</t.tag>
              </div>
              <code class="type-row__token">{t.token}</code>
            </div>
          ))
        }
        <div class="type-row">
          <div class="type-row__sample">
            <p>
              Body paragraph. The quick brown fox jumps over the lazy dog. Use this for the bulk of
              flowing content — it inherits from <code>body</code> and wraps on <code>pretty</code> for
              pleasant line breaks.
            </p>
          </div>
          <code class="type-row__token">--font-size-md</code>
        </div>
        <div class="type-row">
          <div class="type-row__sample">
            <small>Small caption text.</small>
          </div>
          <code class="type-row__token">--font-size-sm</code>
        </div>
        <div class="type-row">
          <div class="type-row__sample">
            <p class="type-caption">Caption text — copyright lines, metadata, fine print.</p>
          </div>
          <code class="type-row__token">--font-size-caption</code>
        </div>
      </div>

      <h3 class="subhead">Heading rhythm</h3>
      <p>
        In <code>base.css</code> every heading gets <code>--space-lg</code> above it and
        <code>--space-xs</code> below, with h2 stepped up to <code>--space-xl</code>. The tight
        space below is deliberate — a heading should sit with the content it introduces rather than
        float between two blocks.
      </p>
      <p>
        Content pages open the space above up a step from the base scale, since a lone measure of
        prose can carry it. Set in <code>ContentPage.astro</code>.
      </p>
      <table>
        <thead>
          <tr><th>Space above</th><th>Content page</th><th>Base</th></tr>
        </thead>
        <tbody>
          <tr><td>h2</td><td>--space-2xl (48px)</td><td>--space-xl (32px)</td></tr>
          <tr><td>h3</td><td>--space-xl (32px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>h4</td><td>--space-lg (24px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>h5, h6</td><td>--space-md (16px)</td><td>--space-lg (24px)</td></tr>
          <tr><td>paragraph</td><td>--space-md (16px)</td><td>--space-md (16px)</td></tr>
        </tbody>
      </table>
      <p>
        h5 and h6 land on the same gap as a paragraph, on purpose: at that depth a heading reads as
        a run-in label rather than a section break. A page intro carries
        <code>--space-3xl</code> below it, dropping to <code>--space-xl</code> when it holds a subtitle
        or a byline — either one closes the block visually, so the larger gap stops earning its place.
      </p>
    </section>

    <section id="links" class="section">
      <div class="section__head">
        <h2>Links</h2>
        <p>
          Anchor defaults live in <code>base.css</code>. Focus rings come from <code
            >--color-focus</code
          >.
        </p>
      </div>
      <ul class="link-list">
        <li><a href="#links">Default link — hover to see the color shift</a></li>
        <li><a href="https://example.com" rel="external">External link</a></li>
        <li>
          Inline: visit the <a href="#colors">colors section</a> to see tokens in context, or jump to
          <a href="#typography">typography</a>.
        </li>
      </ul>

      <h3 class="subhead">On accent background</h3>
      <p>
        <code>--color-focus</code> is the same hue as <code>--color-accent</code>, so the default
        ring disappears on an accent-colored surface. Override <code>outline-color</code> to <code
          >--color-accent-contrast</code
        > wherever a link sits on <code>--color-accent</code> (see the header nav).
      </p>
      <div class="link-on-accent">
        <a href="#links" class="link-on-accent__link">Link on accent — tab to reveal the ring</a>
      </div>
    </section>

    <section id="inline" class="section">
      <div class="section__head">
        <h2>Inline formatting</h2>
        <p>
          Emphasis primitives that flow inside paragraphs. Inherit color and size from the
          surrounding text.
        </p>
      </div>
      <p>
        A paragraph with <strong>bold text</strong>, <em>italic text</em>, and
        <strong><em>bold italic</em></strong> together. You can also use <code>inline code</code> for
        technical terms like <code>Array.prototype.map()</code>.
      </p>
    </section>

    <section id="lists" class="section">
      <div class="section__head">
        <h2>Lists</h2>
        <p>
          Lists use <code>padding-inline-start: var(--space-lg)</code> from <code>base.css</code>.
          Markers stay inside the content box.
        </p>
      </div>
      <h3 class="subhead">Unordered</h3>
      <ul>
        <li>First item</li>
        <li>Second item</li>
        <li>
          Third item with a nested list
          <ul>
            <li>Nested item A</li>
            <li>Nested item B</li>
          </ul>
        </li>
      </ul>
      <h3 class="subhead">Ordered</h3>
      <ol>
        <li>Step one</li>
        <li>Step two</li>
        <li>
          Step three with a nested list
          <ol>
            <li>Sub-step A</li>
            <li>Sub-step B</li>
          </ol>
        </li>
      </ol>
    </section>

    <section id="blockquotes" class="section">
      <div class="section__head">
        <h2>Blockquotes</h2>
        <p>
          Left border uses <code>--color-accent</code>. Styled in <code>base.css</code>, so a
          Markdown <code>&gt;</code> quote and a <code>&lt;Quote&gt;</code> get the same treatment.
        </p>
        <p>
          The quote sets in <code>--font-serif</code> at <code>--font-size-lg</code> — a step up from
          body copy, so it reads as a change of voice rather than indented body text. An attribution line
          stays on the sans body scale: it is a label about the quote, not part of it, and that contrast
          is what marks the boundary between the two.
        </p>
      </div>
      <blockquote>
        <p>The best time to plant a tree was twenty years ago. The second best time is now.</p>
      </blockquote>
      <h3 class="subhead">Multi-paragraph</h3>
      <blockquote>
        <p>This is the first paragraph inside the quote.</p>
        <p>
          And this is the second paragraph. Blockquotes can contain <strong>bold</strong>, <em
            >italic</em
          >, and other inline formatting.
        </p>
      </blockquote>

      <h3 class="subhead">Attributed</h3>
      <p>
        <code>&lt;Quote cite role marker&gt;</code>. A blockquote with an attribution line, so pull
        quotes can be written in Markdown without hand-rolling the
        <code>&lt;footer&gt;</code>/<code>&lt;cite&gt;</code> markup each time. <code>role</code> is optional,
        and <code>marker</code> overrides the leading <code>~</code>.
      </p>
      <Quote cite="ToniAnn" role="Redwoods member">
        “Redwoods is one of the only communities where I feel like I can not only grow in my own DS
        practice by learning from others, but also have a hand in shaping the world of design
        systems at large.”
      </Quote>
      <Quote cite="John Muir" marker="―">
        “When one tugs at a single thing in nature, he finds it attached to the rest of the world.”
      </Quote>
    </section>

    <section id="rules" class="section">
      <div class="section__head">
        <h2>Horizontal rules</h2>
        <p>
          Thin divider using <code>--color-border</code>, with <code>--space-lg</code> block margin. Styled
          in <code>base.css</code>.
        </p>
      </div>
      <p>Content above the rule.</p>
      <hr />
      <p>Content below the rule.</p>
    </section>

    <section id="tables" class="section">
      <div class="section__head">
        <h2>Tables</h2>
        <p>
          Full-width with collapsed borders. Rows separated by <code>--color-border</code>. Styled
          in <code>base.css</code>.
        </p>
      </div>
      <table>
        <thead>
          <tr><th>Token</th><th>Value</th><th>Usage</th></tr>
        </thead>
        <tbody>
          <tr><td>--space-xs</td><td>8px</td><td>Tight gaps</td></tr>
          <tr><td>--space-md</td><td>16px</td><td>Default spacing</td></tr>
          <tr><td>--space-lg</td><td>24px</td><td>Section padding</td></tr>
        </tbody>
      </table>
    </section>

    <section id="images" class="section">
      <div class="section__head">
        <h2>Images</h2>
        <p>
          Images are fluid by default — <code>max-width: 100%</code> and
          <code>height: auto</code> via <code>base.css</code>. Use Astro's <code>&lt;Image&gt;</code
          >
          component for assets in <code>src/assets/</code> so they're optimized.
        </p>
      </div>
      <Image src={trees} alt="Illustrated redwood trees" width={320} />
    </section>

    <section id="code" class="section">
      <div class="section__head">
        <h2>Code</h2>
        <p>
          Inline <code>code</code> gets a subtle background from <code>--color-border</code>. For
          code blocks, use Astro's <code>&lt;Code&gt;</code> component with the
          <code>github-light-high-contrast</code> Shiki theme for WCAG AA compliance.
        </p>
      </div>
      <h3 class="subhead">Inline</h3>
      <p>
        Use <code>var(--color-accent)</code> for brand highlights, or run <code>pnpm dev</code> to start
        the server.
      </p>
      <h3 class="subhead">Block (with language)</h3>
      <Code code={codeSampleJs} lang="js" theme="github-light-high-contrast" />

      <h3 class="subhead">Block (plain)</h3>
      <Code code={codeSamplePlain} theme="github-light-high-contrast" />
    </section>

    <section id="spacing" class="section">
      <div class="section__head">
        <h2>Spacing</h2>
        <p>
          T-shirt scale from <code>3xs</code> to <code>4xl</code>. Use for margin, padding, and gap.
          Don't use in places where the values align coincidently.
        </p>
      </div>
      <div class="scale-list">
        {
          spacingSteps.map((step) => (
            <div class="scale-row">
              <span class="scale-row__label">space-{step}</span>
              <div class="scale-row__bar" style={`width: var(--space-${step})`} />
              <code class="scale-row__token">--space-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section id="radii" class="section">
      <div class="section__head">
        <h2>Radii</h2>
        <p>Rounded corners, from crisp to pill.</p>
      </div>
      <div class="radii-grid">
        {
          radiiSteps.map((step) => (
            <div class="radii-sample">
              <div class="radii-sample__tile" style={`border-radius: var(--radius-${step})`} />
              <span class="radii-sample__name">radius-{step}</span>
              <code class="radii-sample__token">--radius-{step}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section id="buttons" class="section">
      <div class="section__head">
        <h2>Buttons</h2>
        <p>
          <code>&lt;Button variant size href type disabled /&gt;</code>. When <code>href</code> is set
          the component renders an <code>&lt;a&gt;</code> styled as a button.
        </p>
      </div>

      <h3 class="subhead">Variants (size md)</h3>
      <div class="cluster">
        {
          buttonVariants.map((v) => (
            <Button variant={v}>{v.charAt(0).toUpperCase() + v.slice(1)}</Button>
          ))
        }
      </div>

      <h3 class="subhead">Sizes (primary)</h3>
      <div class="cluster cluster--baseline">
        {buttonSizes.map((s) => <Button size={s}>Size {s}</Button>)}
      </div>

      <h3 class="subhead">States</h3>
      <div class="cluster">
        <Button>Default</Button>
        <Button>Focused (tab to reveal)</Button>
        <Button disabled>Disabled</Button>
      </div>

      <h3 class="subhead">Rendered as anchor</h3>
      <div class="cluster">
        <Button variant="secondary" href="#buttons">Anchor button</Button>
      </div>
    </section>

    <section id="button-row" class="section">
      <div class="section__head">
        <h2>Button row</h2>
        <p>
          <code>&lt;ButtonRow&gt;</code>. Lays a group of buttons out in a wrapping row with
          <code>--space-sm</code> between them. <code>base.css</code> spaces prose through adjacency (<code
            >p + p</code
          >, <code>ul + p</code>), which a wrapper element breaks, so the row carries its own <code
            >--space-md</code
          > block margin — that collapses against its neighbours to the same gaps the adjacency chain
          produced.
        </p>
      </div>

      <ButtonRow>
        <Button href="#button-row" size="sm">Join Redwoods</Button>
        <Button href="#button-row" variant="secondary" size="sm">Read our values ↓</Button>
      </ButtonRow>
    </section>

    <section id="hero" class="section">
      <div class="section__head">
        <h2>Hero</h2>
        <p>
          <code>&lt;Hero&gt;</code>. The opening display headline for a page. Renders an
          <code>&lt;h2&gt;</code> at <code>--font-size-hero</code> from 600px up, a step clear of
          <code>--font-size-3xl</code> so the page's opening statement never matches a section heading.
          Below 600px it drops to <code>--font-size-2xl</code>: at 40px a full hero sentence sets as
          nine lines in a phone-width column and pushes itself off the screen. The step is a
          viewport media query, not a container query — the main column is not monotonic (it narrows
          when the rail appears and again when the aside splits off), so sizing on the column fired
          the step three times across the viewport range. Wrap words in <code
            >&lt;span class="accent"&gt;</code
          > to pick up <code>--color-green</code>.
        </p>
      </div>

      <Hero>
        Redwoods is a group of <span class="accent">life-long learners</span> committed to supporting
        each other.
      </Hero>
    </section>

    <section id="lede" class="section">
      <div class="section__head">
        <h2>Lede</h2>
        <p>
          <code>&lt;Lede&gt;</code>. Wraps the opening block of a page — a headline, the copy under
          it, and whatever closes it out. <code>base.css</code> spaces prose by adjacency, tuned for body
          copy at the reading measure; this block runs at display size and wants a looser scale, since
          8px under a 48px headline reads as a collision. Children step apart by
          <code>--space-lg</code>, and a closing <code>blockquote</code> gets
          <code>--space-xl</code> so it reads as the end of the block rather than another beat.
        </p>
        <p>
          It owns the gap below it: <code>display: flow-root</code> traps the last child's trailing margin
          inside the block, and the block-start margin of whatever follows is zeroed. So the space under
          a lede is one number at every width, not a collapsed pair.
          <code>src/pages/index.mdx</code> is the canonical use.
        </p>
      </div>

      <div class="lede-demo">
        <Lede>
          <h3 class="lede-demo__hero">An opening block at display size</h3>
          <p>
            The copy under the headline steps away from it by <code>--space-lg</code> rather than the
            paragraph gap it would get from the base scale.
          </p>
        </Lede>
        <h4>Our Values</h4>
        <p>
          Body copy picks up here. The gap above this heading is the lede's own block-end margin —
          the heading's <code>margin-block-start</code> is zeroed so the two don't stack.
        </p>
      </div>
    </section>

    <section id="entry-card" class="section">
      <div class="section__head">
        <h2>Entry card</h2>
        <p>
          <code>&lt;EntryCard href primaryLabel secondaryLabel date endDate tone /&gt;</code>. A
          card for linking to Field Notes articles and events. The whole card is a single anchor: a
          date block on the left (its shade calculated from the tone) and a secondary label above a
          bold primary label on the right. Pass a <code>date</code> alone for a single day, or add
          <code>endDate</code> for a range.
        </p>
      </div>

      <h3 class="subhead">Dates</h3>
      <div class="entry-card-demo">
        <EntryCard
          href="#entry-card"
          secondaryLabel="Ben Callahan"
          primaryLabel="The Question Episode 057 Recap"
          date={new Date(Date.UTC(2025, 6, 10))}
        />
        <EntryCard
          href="#entry-card"
          secondaryLabel="Bristol, UK"
          primaryLabel="Converge, 2025"
          date={new Date(Date.UTC(2025, 9, 30))}
          endDate={new Date(Date.UTC(2025, 9, 31))}
        />
        <EntryCard
          href="#entry-card"
          secondaryLabel="London, UK"
          primaryLabel="Cross-month conference"
          date={new Date(Date.UTC(2025, 9, 30))}
