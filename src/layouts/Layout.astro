---
// Fonts are self-hosted rather than pulled from Google Fonts: that request was
// render-blocking on a third-party origin and then chained a second hop to
// fonts.gstatic.com for the files themselves. Bundled here, the @font-face
// rules ride along in the page stylesheet and the woff2s come off our own
// already-open connection. `wght` is the weight-only cut of Source Serif 4 —
// we never vary optical size, and the `opsz`/`standard` cuts are ~70 KiB more.
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
// The three faces every page is guaranteed to paint: body copy, headings, and
// the italic serif of the "Join" link in the global nav. Preloading takes them
// off the stylesheet's dependency chain — otherwise they aren't discovered
// until the CSS has parsed, and the italic arrives late enough to visibly swap.
// Italic sans is deliberately not here: whether a page needs it depends on its
// content (an <em>, a <cite>), so it isn't worth the bytes up front.
import sourceSansLatin from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import sourceSerifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sourceSerifLatinItalic from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url';
import '../styles/global.css';
import Page from '../components/Page.astro';
import Seo from '../components/Seo.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { headerBackground } from '../lib/header-background';
import { site } from '../lib/site';

interface Props extends SeoProps {
  aside?: boolean;
}

const { aside = true, ...seo } = Astro.props;
const base = import.meta.env.BASE_URL;
const background = await headerBackground();
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="preload" as="font" type="font/woff2" href={sourceSansLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sourceSerifLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sourceSerifLatinItalic} crossorigin />
    {
      /* The trees are a CSS background, so the preload scanner can't find them
        on its own — without this the LCP request waits on the stylesheet. The
        media query mirrors the one in Header.astro that drops the image on
        very short viewports. */
    }
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={background.src}
      fetchpriority="high"
      media="(min-height: 401px)"
    />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} />
  </head>
  <body>
    <Page aside={aside}>
      <slot />
    </Page>
  </body>
</html>
