---
import Layout from './Layout.astro';
import type { Props as SeoProps } from '../components/Seo.astro';

interface Props extends SeoProps {
  subtitle?: string;
  aside?: boolean;
  toc?: boolean;
}

// `toc` is explicit rather than inferred from Astro.slots.has('toc'), which
// reports true even when the slotted element sits inside a falsy expression.
const {
  subtitle,
  aside = true,
  toc = false,
  // Markdown pages arrive with `layout` alongside their real frontmatter;
  // it isn't metadata and has no business reaching <head>.
  layout: _layout,
  ...seo
} = Astro.props.frontmatter ?? Astro.props;

const { title } = seo;
---

<Layout {...seo} description={seo.description ?? subtitle} aside={aside}>
  <div class="content-page">
    {
      title && (
        <header class="content-page__intro">
          <slot name="breadcrumb" />
          <h2>{title}</h2>
          {subtitle && <p class="content-page__subtitle">{subtitle}</p>}
          {Astro.slots.has('meta') && (
            <div class="content-page__meta">
              <slot name="meta" />
            </div>
          )}
        </header>
      )
    }
    {
      toc && (
        <div class="content-page__rail">
          <slot name="toc" />
        </div>
      )
    }
    <div class="content-page__body"><slot /></div>
  </div>
</Layout>

<style>
  .content-page {
    max-width: var(--layout-prose-max);
    margin: 0 auto;
  }

  /* The rail sits in flow between the title and the body, so the reading order
     is heading → contents → article. It used to move out to a gutter column
     once main was wide enough, which needed --layout-prose-max + --space-xl +
     240px of rail — 944px. Main tops out at 840px now that the aside has a
     fixed column, so that never came back on; the grid it switched to is gone
     rather than left unreachable. Widening main past 944px would earn it back. */
  .content-page__rail {
    margin-block-end: var(--space-xl);
  }

  .content-page__intro {
    margin-block-end: var(--space-3xl);
  }

  /* A subtitle or a byline already gives the intro visual closure, so the big
     gap meant to separate a bare title from the first content heading reads as
     too much dead air here — tighten it up. */
  .content-page__intro:has(.content-page__subtitle),
  .content-page__intro:has(.content-page__meta) {
    margin-block-end: var(--space-xl);
  }

  .content-page__subtitle {
    font-size: var(--font-size-xl);
    font-family: var(--font-serif);
  }

  /* Content pages carry a little more air above headings than the base scale,
     since a lone measure of prose can take it — but only a step more. At the
     prose measure, 64px above an h2 is roughly three lines of body copy and
     reads as a gap rather than as hierarchy.

     h5 and h6 land on the same 16px as the paragraph gap, which is the point —
     at those levels the heading is a run-in label, not a section break. */
  .content-page :global(h2) {
    margin-block-start: var(--space-2xl);
  }

  .content-page .content-page__intro :global(h2) {
    margin-block-start: 0;
  }

  .content-page :global(h3) {
    margin-block-start: var(--space-xl);
  }

  .content-page :global(h4) {
    margin-block-start: var(--space-lg);
  }

  .content-page :global(h5),
  .content-page :global(h6) {
    margin-block-start: var(--space-md);
  }
</style>
