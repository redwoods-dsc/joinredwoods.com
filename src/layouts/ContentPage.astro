---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Layout from './Layout.astro';
import Note from '../components/Note.astro';
import type { Props as SeoProps } from '../components/Seo.astro';

interface Props extends SeoProps {
  subtitle?: string;
  /* Filename of artwork in src/assets, set behind the title and off to its
     right. A name rather than an import because a Markdown page can only hand
     this layout frontmatter, and frontmatter can't carry a module. The title
     stays live text either way, so its size is the type scale's rather than a
     consequence of how wide the column happens to be. */
  headingImage?: string;
  /* A caveat or aside closing the intro, set apart from the subtitle. Kept out
     of `subtitle` so it stays out of the meta description too, where a note
     about method spends characters the search snippet needs for the subject. */
  note?: string;
  aside?: boolean;
  toc?: boolean;
}

// `toc` is explicit rather than inferred from Astro.slots.has('toc'), which
// reports true even when the slotted element sits inside a falsy expression.
const {
  subtitle,
  headingImage,
  note,
  aside = true,
  toc = false,
  // Markdown pages arrive with `layout` alongside their real frontmatter;
  // it isn't metadata and has no business reaching <head>.
  layout: _layout,
  ...seo
} = Astro.props.frontmatter ?? Astro.props;

const { title } = seo;

// A CSS background is invisible to the preload scanner, so it's resolved here
// and handed to the stylesheet as a URL rather than written into it — the same
// move header-background.ts makes for the trees.
const artwork = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

function resolveHeadingArt(name: string): ImageMetadata {
  const found = Object.entries(artwork).find(([path]) => path.endsWith(`/${name}`));
  // Loudly, rather than rendering a title with nothing behind it: a filename
  // that no longer resolves is a typo or a deleted file, and both should stop
  // the build rather than quietly ship a page missing its artwork.
  if (!found) throw new Error(`headingImage "${name}" is not in src/assets.`);
  return found[1].default;
}

const headingArt = headingImage
  ? await getImage({ src: resolveHeadingArt(headingImage), format: 'webp', width: 320 })
  : undefined;
---

<Layout {...seo} description={seo.description ?? subtitle} aside={aside}>
  <div class="content-page">
    {
      title && (
        <header class="content-page__intro">
          <slot name="breadcrumb" />
          <h2 style={headingArt && `--heading-art: url(${headingArt.src})`}>{title}</h2>
          {subtitle && <p class="content-page__subtitle">{subtitle}</p>}
          {note && <Note>{note}</Note>}
          {Astro.slots.has('meta') && (
            <div class="content-page__meta">
              <slot name="meta" />
            </div>
          )}
        </header>
      )
    }
    {
      toc && (
        <div class="content-page__rail">
          <slot name="toc" />
        </div>
      )
    }
    <div class="content-page__body"><slot /></div>
  </div>
</Layout>

<style>
  /* Not centred: the intro, rail and body share this one left edge. */
  .content-page {
    max-width: var(--layout-prose-max);
  }

  .content-page__rail {
    margin-block-end: var(--space-xl);
  }

  .content-page__intro {
    margin-block-end: var(--space-3xl);
  }

  /* A subtitle or byline already closes the intro, so it needs less air below. */
  .content-page__intro:has(.content-page__subtitle),
  .content-page__intro:has(.content-page__meta) {
    margin-block-end: var(--space-xl);
  }

  .content-page__subtitle {
    font-size: var(--font-size-xl);
    font-family: var(--font-serif);
  }

  /* One step more air above headings than the base scale — a lone measure of
     prose can take it, but 64px above an h2 reads as a gap, not hierarchy. h5
     and h6 sit at the paragraph gap: at those levels they're run-in labels. */
  .content-page :global(h2) {
    margin-block-start: var(--space-2xl);
  }

  .content-page .content-page__intro :global(h2) {
    margin-block-start: 0;
  }

  /* Artwork behind the title rather than in place of it, so the heading stays
     live text at the size the type scale gives it — an <img> would have scaled
     with the column and taken the apparent size of the title with it.

     Decorative, so it belongs in CSS: there is nothing here a screen reader
     should announce, and the h2 keeps its own text either way. The custom
     property is only set when a page supplies one, so the rule is inert
     elsewhere. */
  .content-page__intro h2 {
    --heading-art-size: 8rem;

    /* The page's title is the largest thing on it, which is the role
       --font-size-hero already names — 2.5rem, a step clear of the h2 the base
       scale would otherwise give this. Shared rather than duplicated: a second
       token at the same value is a pair that drifts. */
    font-size: var(--font-size-hero);
    display: flex;
    align-items: center;
    min-height: var(--heading-art-size);
    padding-inline-end: calc(var(--heading-art-size) + var(--space-md));
    background-image: var(--heading-art, none);
    background-repeat: no-repeat;
    background-position: right center;
    background-size: contain;
  }

  /* Nothing to reserve room for without artwork. */
  .content-page__intro h2:not([style]) {
    min-height: 0;
    padding-inline-end: 0;
  }

  .content-page :global(h3) {
    margin-block-start: var(--space-xl);
  }

  .content-page :global(h4) {
    margin-block-start: var(--space-lg);
  }

  .content-page :global(h5),
  .content-page :global(h6) {
    margin-block-start: var(--space-md);
  }

  /* Past 1700 the main column runs ~156px wider than the prose measure, which
     is enough slack for the measure to sit centred rather than pinned left.
     Everything holds that measure; only a quote's rule reaches outside it.

     Everything is reached with :global(): these are a page's own children,
     authored in .mdx, so they carry the calling page's scope and not this
     layout's. The Lede is opened up too and its own children re-constrained,
     since the homepage's hero sits one level down inside it. */
  @media (min-width: 1700px) {
    .content-page {
      max-width: none;
    }

    .content-page__intro,
    .content-page__rail,
    .content-page__body > :global(*),
    .content-page__body :global(.lede) > :global(*) {
      max-width: var(--layout-prose-max);
      margin-inline: auto;
    }

    .content-page__body > :global(.lede) {
      max-width: none;
    }

    /* Greedy rather than the balance base.css gives headings: at this size the
       hero fills each line and steps down to a short last one, which reads as
       a deliberate close rather than four evenly-set lines. */
    .content-page__body :global(.hero) {
      text-wrap: unset;
    }

    /* The quoted text holds the same measure as the prose; only the rule and
       its padding sit outside it, hanging into the slack on the start side. */
    .content-page__body > :global(blockquote),
    .content-page__body :global(.lede) > :global(blockquote) {
      --quote-rule-hang: calc(var(--quote-rule-width) + var(--space-md));

      max-width: calc(var(--layout-prose-max) + var(--quote-rule-hang));
      margin-inline-start: calc((100% - var(--layout-prose-max)) / 2 - var(--quote-rule-hang));
      margin-inline-end: auto;
    }

    /* The callout already paints past the column on its own; only its text
       needs to hold the same centred measure as the prose around it. */
    .content-page__body > :global(.callout) {
      max-width: none;
    }

    .content-page__body :global(.callout__inner) {
      margin-inline: auto;
    }
  }
</style>
