---
import Layout from './Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props.frontmatter ?? Astro.props;
---

<Layout>
  <div class="content-page">
    <header class="content-page__intro">
      <h1>{title}</h1>
      {subtitle && <p class="content-page__subtitle">{subtitle}</p>}
    </header>
    <slot />
  </div>
</Layout>

<style>
  .content-page {
    max-width: var(--layout-prose-max);
    margin: 0 auto;
  }

  .content-page__intro {
    margin-block-end: var(--space-3xl);
  }

  .content-page__subtitle {
    font-size: var(--font-size-xl);
    font-family: var(--font-serif);
  }

  .content-page :global(h1) {
    margin-block-start: 0;
  }

  .content-page :global(h2) {
    margin-block-start: var(--space-3xl);
  }

  .content-page :global(h3) {
    margin-block-start: var(--space-2xl);
  }

  .content-page :global(h4) {
    margin-block-start: var(--space-xl);
  }

  .content-page :global(h5) {
    margin-block-start: var(--space-lg);
  }

  .content-page :global(h6) {
    margin-block-start: var(--space-md);
  }
</style>
